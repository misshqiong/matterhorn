<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; connect-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'self'">
  <title>Matterhorn Console</title>
  <style>
    :root {
      color-scheme: light dark;
      --paper: #f6f3ea;
      --sheet: #fbf9f2;
      --sheet-soft: #f1ecdf;
      --rule: #d8d2c2;
      --rule2: #c4bca6;
      --ink: #26231c;
      --muted: #6e6858;
      --faint: #9a937f;
      --debit: #a83227;
      --debit-soft: #f5e2df;
      --credit: #2e6647;
      --credit-soft: #e2ecdf;
      --pend: #8a6a1f;
      --pend-soft: #f2e9cf;
      --serif: ui-serif, Georgia, "Times New Roman", serif;
      --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      --sheet-shadow: 2px 3px 0 rgb(38 35 28 / 6%);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #1d1a14;
        --sheet: #24211a;
        --sheet-soft: #2b2720;
        --rule: #3a352a;
        --rule2: #4a4436;
        --ink: #eae4d4;
        --muted: #aaa28d;
        --faint: #7d765f;
        --debit: #e08579;
        --debit-soft: #45231f;
        --credit: #86c7a2;
        --credit-soft: #21362b;
        --pend: #d9b45e;
        --pend-soft: #3d3115;
        --sheet-shadow: 2px 3px 0 rgb(0 0 0 / 30%);
      }
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 14px; line-height: 1.55; overflow-wrap: anywhere; }
    a { color: var(--credit); text-underline-offset: .18em; }
    .shell { width: min(96rem, calc(100% - 2rem)); margin: 0 auto; padding: 1.6rem 0 3rem; }
    .topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; text-align: left;
      border-top: 3px double var(--rule2); border-bottom: 3px double var(--rule2); padding: .8rem .2rem; margin-bottom: 1.1rem; }
    .topbar h1 { margin: .05rem 0 !important; font: 700 24px var(--serif) !important; letter-spacing: .02em; }
    .eyebrow { margin: 0; font: 700 10px var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--faint); }
    .lede { margin: 0 !important; font: italic 13px var(--serif) !important; color: var(--muted); }
    .scope-control { display: grid; gap: .2rem; justify-items: end; }
    .scope-control label { font: 700 10px var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
    select, input, textarea { font-family: inherit; color: var(--ink); }
    .scope-control select { background: var(--sheet); border: 1px solid var(--rule2); padding: .3rem .5rem; font: 13px var(--mono); }
    .scopes-bar { display: flex; align-items: center; gap: .8rem; margin-bottom: 1.2rem; padding: .3rem .2rem .55rem;
      border-bottom: 1px solid var(--rule2); }
    .scopes-bar > .muted { margin: 0; font: italic 13px var(--serif); }
    .scopes-bar .scope-list { display: flex; flex-wrap: wrap; gap: .3rem 1rem; flex: 1; margin: 0; padding: 0; }
    .scope-button { background: none; border: none; padding: .1rem 0; cursor: pointer; color: var(--muted);
      font: 13px var(--mono); border-bottom: 2px solid transparent; }
    .scope-button.active { color: var(--ink); border-bottom-color: var(--debit); font-weight: 700; }
    .pipeline { display: grid; grid-template-columns: minmax(18rem, 22.5rem) minmax(0, 1.4fr) minmax(19rem, 25.5rem); gap: 1.5rem; align-items: start; }
    .zone { display: grid; gap: 1rem; min-width: 0; align-content: start; }
    .zone-head { display: flex; align-items: baseline; gap: .5rem; border-bottom: 1.5px solid var(--ink); padding-bottom: .25rem; position: relative; }
    .zone-head .zone-no { font: 700 italic 16px var(--serif); color: var(--ink); }
    .zone-head h2 { margin: 0; font: 700 11.5px var(--sans); letter-spacing: .18em; text-transform: uppercase; }
    .zone-head .muted { margin: 0 0 0 auto; font: italic 12px var(--serif); color: var(--faint); }
    .zone-head::after { content: none; }
    .card { background: var(--sheet); border: 1px solid var(--rule); box-shadow: var(--sheet-shadow); padding: 1rem 1.1rem; min-width: 0; }
    .zone-memory .card { border-color: var(--rule2); }
    .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: .8rem; margin-bottom: .6rem; }
    .card-head h2 { margin: 0; font: 700 16px var(--serif); }
    .card-head p { margin: .05rem 0 0; }
    .muted, .help, .meta { color: var(--muted); }
    .card-head .muted { font: italic 12px var(--serif); }
    label { font: 700 10.5px var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--faint); display: block; margin-bottom: .25rem; }
    .form-stack { display: grid; gap: .8rem; }
    textarea { width: 100%; min-height: 9.5rem; background: transparent; border: 0; border-bottom: 1px solid var(--rule2);
      background-image: repeating-linear-gradient(transparent, transparent 1.55em, var(--rule) 1.55em, var(--rule) calc(1.55em + 1px));
      line-height: 1.62em; font: 13.5px var(--serif); padding: .1rem 0; resize: vertical; outline: none; }
    input[type="text"], input:not([type]), input[type="datetime-local"] { width: 100%; background: transparent; border: 0;
      border-bottom: 1.5px solid var(--rule2); font: 13.5px var(--mono); padding: .35rem 0; outline: none; }
    input:focus, textarea:focus { border-bottom-color: var(--ink); }
    select { background: var(--sheet); border: 1px solid var(--rule2); padding: .35rem .45rem; font: 13px var(--mono); width: 100%; }
    .synthetic-note { font: 11.5px var(--sans); color: var(--pend); margin: .45rem 0 0; }
    .button-row { display: flex; gap: .6rem; justify-content: flex-end; flex-wrap: wrap; }
    .button { font: 700 11px var(--sans); letter-spacing: .14em; text-transform: uppercase; padding: .48rem .95rem;
      cursor: pointer; border: 1.5px solid var(--ink); background: var(--ink); color: var(--sheet); border-radius: 0; }
    .button.secondary { background: transparent; color: var(--ink); }
    .button.quiet { background: transparent; color: var(--muted); border-color: var(--rule2); }
    .button.small { padding: .28rem .6rem; font-size: 10px; }
    .button:disabled { opacity: .45; cursor: not-allowed; }
    .feed-status { margin-top: .7rem; font: 12px var(--mono); }
    .feed-status.error { color: var(--debit); }
    .feed-status.success { color: var(--credit); }
    pre { background: var(--sheet-soft); border: 1px solid var(--rule); padding: .7rem; font: 11.5px var(--mono);
      overflow: auto; max-height: 16rem; white-space: pre-wrap; word-break: break-word; }
    .scope-list, .matter-list, .value-list, .timeline, .chat-log { list-style: none; margin: 0; padding: 0; }
    .matter-list { display: grid; gap: 0; }
    .matter-button { display: block; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--rule);
      padding: .7rem .2rem; cursor: pointer; color: var(--ink); font: 14px var(--sans); }
    .matter-button strong { display: block; margin-bottom: .3rem; font: 700 15px var(--serif); }
    .matter-button.active { box-shadow: inset 3px 0 var(--debit); padding-left: .7rem; }
    .matter-button.flash { animation: flash 1.25s ease; }
    @keyframes flash { 0% { background: var(--pend-soft); } 100% { background: transparent; } }
    @media (prefers-reduced-motion: reduce) { .matter-button.flash { animation: none; outline: 3px solid var(--pend); } }
    .matter-meta { font: 12px var(--mono); color: var(--muted); }
    .badge { display: inline-block; font: 700 10px var(--sans); letter-spacing: .12em; text-transform: uppercase;
      border: 2px solid var(--credit); color: var(--credit); border-radius: 2px; padding: .08rem .45rem; rotate: -2deg; background: transparent; }
    .badge.danger { border-color: var(--debit); color: var(--debit); }
    .badge.human { border-color: var(--debit); color: var(--debit); rotate: 0deg; font: italic 12px var(--serif); text-transform: none; letter-spacing: 0; border-width: 0 0 1.5px; padding: 0 .1rem; }
    .overdue { color: var(--debit); font-weight: 700; }
    .detail-placeholder { color: var(--faint); font: italic 13.5px var(--serif); padding: 1.4rem .4rem; text-align: center; }
    .value-list { display: grid; }
    .value { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) auto; gap: .6rem; align-items: baseline;
      padding: .55rem 0; border-bottom: 1px solid var(--rule); }
    .value:last-child { border-bottom: 0; }
    .predicate { font: 700 10.5px var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--faint); }
    .value-main { font: 14px var(--serif); min-width: 0; }
    .value-main code, pre code { font: 12px var(--mono); }
    .correct-value { font: italic 12.5px var(--serif); color: var(--muted); background: none; border: none;
      cursor: pointer; text-decoration: underline dotted; padding: 0; }
    .correct-value:hover { color: var(--debit); }
    .evidence { color: var(--muted); font: 11.5px var(--mono); }
    .evidence a, .evidence span, .evidence-chip { font: 11px var(--mono); color: var(--credit);
      border: 0; border-bottom: 1.5px solid var(--credit); background: none; cursor: pointer; padding: 0; text-decoration: none;
      display: inline-block; max-width: 15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
    .timeline { display: grid; gap: 0; margin-top: .4rem; }
    .timeline-item { padding: .5rem 0 .5rem .9rem; border-left: 2px solid var(--rule2); border-bottom: 1px solid var(--rule); }
    .timeline-item:last-child { border-bottom: 0; }
    .timeline-item.human { border-left-color: var(--debit); }
    .result { margin-top: .8rem; }
    .human-result { display: grid; gap: 0; }
    .result-row { padding: .55rem .2rem; border-bottom: 1px solid var(--rule); background: transparent; }
    .result-row:last-child { border-bottom: 0; }
    .workbench-grid { display: grid; grid-template-columns: repeat(2, minmax(7rem, 1fr)); gap: .7rem; }
    .span-two { grid-column: span 2; }
    .chat-log { display: grid; gap: 0; }
    .chat-message { padding: .6rem 0; border-bottom: 1px solid var(--rule); background: transparent; }
    .chat-message p { margin: .1rem 0 .35rem; white-space: pre-wrap; font: 14px var(--serif); }
    .chat-message.user { margin-left: 0; background: transparent; }
    .chat-message.user p { font-style: italic; color: var(--muted); }
    .chat-form { display: grid; grid-template-columns: 1fr auto; gap: .6rem; margin-top: .8rem; align-items: end; }
    .error-box { border: 1.5px solid var(--debit); color: var(--debit); padding: .6rem .7rem; font: 12.5px var(--sans); margin-top: .6rem; }
    .empty { color: var(--faint); font: italic 13px var(--serif); }
    [hidden] { display: none !important; }
    dialog { background: var(--sheet); color: var(--ink); border: 1.5px solid var(--ink); box-shadow: 4px 5px 0 rgb(38 35 28 / 12%); padding: 1.2rem 1.3rem; max-width: 30rem; }
    dialog::backdrop { background: rgb(38 35 28 / 35%); }
    dialog h2 { font: 700 18px var(--serif); margin-top: 0; }
    @media (max-width: 68rem) {
      .pipeline { grid-template-columns: 1fr 1fr; }
      .zone-consume { grid-column: span 2; }
    }
    @media (max-width: 48rem) {
      .pipeline { grid-template-columns: 1fr; }
      .zone-consume { grid-column: auto; }
      .shell { width: min(100% - 1rem, 96rem); padding-top: 1rem; }
      .topbar { flex-direction: column; align-items: flex-start; gap: .4rem; }
      .scope-control { justify-items: start; }
      .workbench-grid { grid-template-columns: 1fr; }
      .span-two { grid-column: auto; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Operator surface · REST client</p>
        <h1 style="font-size:1.55rem;margin:.1rem 0">Matterhorn Console</h1>
        <p class="lede" style="margin:0;font-size:.9rem">Produce evidence → derive matters → consume answers. Every value traces to its source.</p>
      </div>
      <div class="scope-control">
        <label for="scope-select">Active scope</label>
        <select id="scope-select" aria-label="Active scope">
          <option value="">No scopes yet</option>
        </select>
      </div>
    </header>

    <div class="scopes-bar" aria-labelledby="scopes-title">
      <p class="muted" id="scopes-title">Scopes</p>
      <ul class="scope-list" id="scope-list"></ul>
      <button class="button quiet small" id="refresh-scopes" type="button">Refresh</button>
    </div>

    <div class="pipeline">
      <div class="zone zone-produce">
        <div class="zone-head"><span class="zone-no">1</span><h2>Produce</h2><p class="muted">feed raw communication in</p></div>
        <section class="card" aria-labelledby="feed-title">
          <div class="card-head">
            <div>
              <h2 id="feed-title">Feed</h2>
              <p class="muted">Paste, extract, refresh</p>
            </div>
          </div>
          <div class="form-stack">
            <div hidden>
              <label for="feed-scope">Scope id</label>
              <input id="feed-scope" value="demo" maxlength="120" autocomplete="off">
            </div>
            <div>
              <label for="feed-text">Chat, YAML/JSON messages, or EML/mbox</label>
              <textarea id="feed-text" maxlength="200000" placeholder="Dana Reyes: The octo-org launch is in progress."></textarea>
              <p class="synthetic-note">Plain chat has no timestamps, so the server synthesizes increasing times in paste order.</p>
            </div>
            <div class="button-row">
              <button class="button secondary" id="load-sample" type="button">Load sample</button>
              <button class="button" id="extract-feed" type="button">Extract</button>
            </div>
          </div>
          <div class="feed-status" id="feed-status" role="status"></div>
          <pre id="feed-receipt" hidden></pre>
        </section>
      </div>

      <div class="zone zone-memory">
        <div class="zone-head"><span class="zone-no">2</span><h2>Memory</h2><p class="muted">derived matters — the asset</p></div>
        <section class="card" aria-labelledby="matters-title">
          <div class="card-head">
            <div>
              <h2 id="matters-title">Matters</h2>
              <p class="muted">Status, ownership, due dates</p>
            </div>
            <button class="button quiet small" id="refresh-matters" type="button">Refresh</button>
          </div>
          <ul class="matter-list" id="matter-list"></ul>
        </section>

        <section class="card" aria-labelledby="detail-title">
          <div id="matter-detail" class="detail-placeholder">
            <p>Select a matter to inspect current values, timelines, and evidence.</p>
          </div>
        </section>
      </div>

      <div class="zone zone-consume">
        <div class="zone-head"><span class="zone-no">3</span><h2>Consume</h2><p class="muted">ask an agent, or query directly</p></div>
        <section class="card" id="chat-panel" aria-labelledby="chat-title" hidden>
          <div class="card-head">
            <div>
              <h2 id="chat-title">Chat</h2>
              <p class="muted">Host-side model; deterministic query tools only</p>
            </div>
            <span class="badge" id="chat-provider"></span>
          </div>
          <ul class="chat-log" id="chat-log">
            <li class="chat-message">
              <p>Ask about progress, ownership, evidence, or what was true at a specific time.</p>
            </li>
          </ul>
          <form class="chat-form" id="chat-form">
            <input id="chat-input" maxlength="8000" placeholder="What is the current progress?" autocomplete="off">
            <button class="button" type="submit">Ask</button>
          </form>
        </section>

        <section class="card" aria-labelledby="workbench-title">
          <div class="card-head">
            <div>
              <h2 id="workbench-title">Query workbench</h2>
              <p class="muted">The same public deterministic queries used by every client</p>
            </div>
          </div>
          <form id="query-form">
            <div class="workbench-grid">
              <div>
                <label for="query-kind">Query</label>
                <select id="query-kind">
                  <option value="current">current</option>
                  <option value="timeline">timeline</option>
                  <option value="at">at</option>
                  <option value="by-person">by-person</option>
                </select>
              </div>
              <div id="query-subject-wrap">
                <label for="query-subject">Subject key</label>
                <input id="query-subject" autocomplete="off">
              </div>
              <div id="query-predicate-wrap">
                <label for="query-predicate">Predicate</label>
                <input id="query-predicate" value="status" autocomplete="off">
              </div>
              <div id="query-person-wrap" hidden>
                <label for="query-person">Person id</label>
                <input id="query-person" autocomplete="off">
              </div>
              <div id="query-instant-wrap" hidden>
                <label for="query-instant">At instant</label>
                <input id="query-instant" type="datetime-local">
              </div>
            </div>
            <div class="button-row" style="margin-top:.75rem">
              <button class="button" type="submit">Run query</button>
              <button class="button secondary" id="toggle-json" type="button" disabled>Show raw JSON</button>
            </div>
          </form>
          <div class="result" id="query-human"></div>
          <pre class="result" id="query-json" hidden></pre>
        </section>
      </div>
    </div>
  </div>

  <dialog id="correction-dialog">
    <form class="form-stack" id="correction-form">
      <div>
        <p class="eyebrow">Human assertion · P8</p>
        <h2>Correct current value</h2>
        <p class="muted" id="correction-target"></p>
      </div>
      <div>
        <label for="correction-value">New value</label>
        <textarea id="correction-value" required></textarea>
        <p class="help">Plain text stays a string; valid JSON becomes a number, boolean, array, or object.</p>
      </div>
      <div>
        <label for="correction-reason">Reason</label>
        <textarea id="correction-reason" required placeholder="What was wrong, and why is this value correct?"></textarea>
      </div>
      <div>
        <label for="correction-sender">Your name</label>
        <input id="correction-sender" required autocomplete="name" placeholder="Dana Reyes">
      </div>
      <div id="correction-error"></div>
      <div class="button-row">
        <button class="button" type="submit">Record correction ✏️</button>
        <button class="button quiet" id="cancel-correction" type="button">Cancel</button>
      </div>
    </form>
  </dialog>

  <script>
    "use strict";
    const state = { scope: "", matters: [], selected: "", detail: null, queryResult: null, chatHistory: [] };
    const byId = (id) => document.getElementById(id);
    const escapeHtml = (value) => String(value)
      .replaceAll("&", "&amp;").replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;").replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
    const jsonText = (value) => JSON.stringify(value, null, 2);
    const displayValue = (value) => typeof value === "string" ? value : jsonText(value);
    const api = async (path, options = {}) => {
      const response = await fetch(path, {
        ...options,
        headers: { "Content-Type": "application/json", ...(options.headers || {}) }
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error?.message || `HTTP ${response.status}`);
      return payload;
    };

    async function loadScopes(selectScope = null) {
      const scopes = await api("/v1/scopes");
      const select = byId("scope-select");
      select.innerHTML = scopes.length
        ? scopes.map((scope) => `<option value="${escapeHtml(scope)}">${escapeHtml(scope)}</option>`).join("")
        : '<option value="">No scopes yet</option>';
      byId("scope-list").innerHTML = scopes.length
        ? scopes.map((scope) => `<li><button type="button" class="scope-button ${scope === state.scope ? "active" : ""}" data-scope="${escapeHtml(scope)}">${escapeHtml(scope)}</button></li>`).join("")
        : '<li class="empty">Feed a scope to begin.</li>';
      if (scopes.length) {
        const desired = selectScope && scopes.includes(selectScope)
          ? selectScope : (scopes.includes(state.scope) ? state.scope : scopes[0]);
        select.value = desired;
        if (desired !== state.scope) await selectActiveScope(desired);
      } else {
        state.scope = "";
        renderMatters();
      }
    }

    async function selectActiveScope(scope) {
      state.scope = scope;
      state.selected = "";
      state.detail = null;
      byId("feed-scope").value = scope || byId("feed-scope").value;
      document.querySelectorAll(".scope-button").forEach((item) => item.classList.toggle("active", item.dataset.scope === scope));
      byId("scope-select").value = scope;
      await loadMatters();
      byId("matter-detail").className = "detail-placeholder";
      byId("matter-detail").innerHTML = "<p>Select a matter to inspect current values, timelines, and evidence.</p>";
    }

    async function loadMatters() {
      if (!state.scope) { state.matters = []; renderMatters(); return; }
      state.matters = await api(`/v1/scopes/${encodeURIComponent(state.scope)}/matters`);
      renderMatters();
    }

    function renderMatters() {
      const list = byId("matter-list");
      if (!state.matters.length) {
        list.innerHTML = '<li class="empty">No projected matters in this scope.</li>';
        return;
      }
      list.innerHTML = state.matters.map((matter) => {
        const due = matter.due ? new Date(matter.due) : null;
        const overdue = due && due < new Date() && !["done", "completed", "closed"].includes(matter.status);
        const owners = (matter.owners || []).join(", ") || "unassigned";
        return `<li>
          <button type="button" class="matter-button ${matter.subject_key === state.selected ? "active" : ""}"
            data-subject="${escapeHtml(matter.subject_key)}">
            <strong>${escapeHtml(matter.title)}</strong>
            <span class="badge">${escapeHtml(matter.status ?? "no status")}</span>
            <div class="matter-meta">
              <span>Owner: ${escapeHtml(owners)}</span>
              ${due ? `<span class="${overdue ? "overdue" : ""}">${overdue ? "Overdue · " : "Due · "}${escapeHtml(due.toLocaleString())}</span>` : ""}
            </div>
          </button>
        </li>`;
      }).join("");
    }

    async function loadDetail(subjectKey) {
      state.selected = subjectKey;
      renderMatters();
      state.detail = await api(`/v1/scopes/${encodeURIComponent(state.scope)}/matters/${encodeURIComponent(subjectKey)}`);
      byId("query-subject").value = subjectKey;
      renderDetail();
    }

    function evidenceHtml(value) {
      if (!value.source_refs?.length) return '<span>No source refs</span>';
      return value.source_refs.map((source) => source.uri
        ? `<a href="${escapeHtml(source.uri)}" target="_blank" rel="noreferrer">${escapeHtml(source.source_id)}</a>`
        : `<span>${escapeHtml(source.source_id)}</span>`).join("");
    }

    function renderDetail() {
      const detail = state.detail;
      const target = byId("matter-detail");
      target.className = "";
      const values = detail.current.length
        ? detail.current.map((value) => `<li class="value">
            <div>
              <div class="predicate">${escapeHtml(value.predicate)}</div>
              ${value.origin === "human" ? '<span class="badge human">✏️ human</span>' : '<span class="badge">model</span>'}
            </div>
            <div class="value-main">
              <code>${escapeHtml(displayValue(value.value))}</code>
              <div class="meta">effective ${escapeHtml(new Date(value.valid_from).toLocaleString())}</div>
              <div class="evidence">${evidenceHtml(value)}</div>
            </div>
            <button type="button" class="button secondary small correct-value"
              data-predicate="${escapeHtml(value.predicate)}"
              data-value="${escapeHtml(jsonText(value.value))}">Correct</button>
          </li>`).join("")
        : '<li class="empty">No current values.</li>';
      const timelines = Object.entries(detail.timeline).map(([predicate, entries]) => `
        <details>
          <summary>${escapeHtml(predicate)} · ${entries.length} interval${entries.length === 1 ? "" : "s"}</summary>
          <ul class="timeline">
            ${entries.map((entry) => `<li class="timeline-item ${entry.origin === "human" ? "human" : ""}">
              <strong>${escapeHtml(displayValue(entry.value))}</strong>
              ${entry.origin === "human" ? '<span class="badge human">✏️ human</span>' : ""}
              <div class="meta">${escapeHtml(entry.valid_from)} → ${escapeHtml(entry.valid_to || "now")}</div>
              <div class="evidence">${evidenceHtml(entry)}</div>
            </li>`).join("")}
          </ul>
        </details>`).join("");
      target.innerHTML = `
        <div class="card-head">
          <div>
            <p class="eyebrow">Matter detail</p>
            <h2 id="detail-title">${escapeHtml(detail.title)}</h2>
            <p class="muted">${escapeHtml(detail.subject_key)} · ${escapeHtml(detail.subject_type)}</p>
          </div>
          <span class="badge human">Corrections are first-class ✏️</span>
        </div>
        <ul class="value-list">${values}</ul>
        <div style="display:grid;gap:.7rem;margin-top:1rem">${timelines}</div>`;
    }

    function openCorrection(button) {
      const value = JSON.parse(button.dataset.value);
      byId("correction-target").textContent = `${state.detail.title} · ${button.dataset.predicate}`;
      byId("correction-value").value = typeof value === "string" ? value : jsonText(value);
      byId("correction-reason").value = "";
      byId("correction-sender").value = localStorage.getItem("matterhorn.console.sender") || "";
      byId("correction-form").dataset.predicate = button.dataset.predicate;
      byId("correction-error").innerHTML = "";
      byId("correction-dialog").showModal();
    }

    async function submitCorrection(event) {
      event.preventDefault();
      const sender = byId("correction-sender").value.trim();
      const reason = byId("correction-reason").value.trim();
      let value = byId("correction-value").value.trim();
      try { value = JSON.parse(value); } catch (_) { /* Intentional string value. */ }
      localStorage.setItem("matterhorn.console.sender", sender);
      const now = new Date().toISOString();
      const sourceId = `console:${crypto.randomUUID()}`;
      try {
        await api(`/v1/scopes/${encodeURIComponent(state.scope)}/corrections`, {
          method: "POST",
          body: JSON.stringify({
            subject_key: state.detail.subject_key,
            subject_type: state.detail.subject_type,
            predicate: byId("correction-form").dataset.predicate,
            object_value: value,
            valid_from: now,
            source_refs: [{
              source_id: sourceId,
              sent_at: now,
              sender,
              excerpt: `Console correction. Reason: ${reason}`
            }]
          })
        });
        byId("correction-dialog").close();
        await loadDetail(state.detail.subject_key);
        await loadMatters();
      } catch (error) {
        byId("correction-error").innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
      }
    }

    function updateQueryFields() {
      const kind = byId("query-kind").value;
      const byPerson = kind === "by-person";
      byId("query-person-wrap").hidden = !byPerson;
      byId("query-subject-wrap").hidden = byPerson;
      byId("query-predicate-wrap").hidden = byPerson;
      byId("query-instant-wrap").hidden = kind !== "at";
    }

    async function runQuery(event) {
      event.preventDefault();
      if (!state.scope) return;
      const kind = byId("query-kind").value;
      const params = new URLSearchParams();
      if (kind === "by-person") params.set("person_id", byId("query-person").value);
      else {
        params.set("subject_key", byId("query-subject").value);
        params.set("predicate", byId("query-predicate").value);
        if (kind === "at") params.set("instant", new Date(byId("query-instant").value).toISOString());
      }
      try {
        state.queryResult = await api(`/v1/scopes/${encodeURIComponent(state.scope)}/query/${kind}?${params}`);
        renderQueryResult();
      } catch (error) {
        state.queryResult = { error: error.message };
        renderQueryResult();
      }
    }

    function renderQueryResult() {
      const result = state.queryResult;
      byId("toggle-json").disabled = false;
      byId("query-json").textContent = jsonText(result);
      if (result.error) {
        byId("query-human").innerHTML = `<div class="error-box">${escapeHtml(result.error)}</div>`;
        return;
      }
      const rows = Array.isArray(result) ? result : [result];
      byId("query-human").innerHTML = rows.length
        ? `<div class="human-result">${rows.map((row) => `<div class="result-row">
            <strong>${escapeHtml(row.title || row.predicate || row.subject_key || "Result")}</strong>
            <div>${escapeHtml(displayValue(row.value ?? row.current ?? row))}</div>
            ${row.source_ids?.length ? `<div class="evidence">${row.source_ids.map((id) => `<span>${escapeHtml(id)}</span>`).join("")}</div>` : ""}
          </div>`).join("")}</div>`
        : '<div class="empty">No values matched.</div>';
    }

    async function extractFeed() {
      const scope = byId("feed-scope").value.trim();
      const text = byId("feed-text").value;
      byId("feed-status").className = "feed-status";
      byId("feed-status").textContent = "Extracting and flushing…";
      byId("feed-receipt").hidden = true;
      try {
        const receipt = await api(`/v1/scopes/${encodeURIComponent(scope)}/ingest`, {
          method: "POST",
          body: JSON.stringify({ text, wait: true })
        });
        byId("feed-status").className = "feed-status success";
        byId("feed-status").textContent = `Detected ${receipt.input_format}; ${receipt.status}. Gate accepted ${receipt.gate?.accepted ?? 0}.`;
        byId("feed-receipt").textContent = jsonText(receipt);
        byId("feed-receipt").hidden = false;
        await loadScopes(scope);
        await loadMatters();
      } catch (error) {
        byId("feed-status").className = "feed-status error";
        byId("feed-status").textContent = error.message;
      }
    }

    async function loadChatConfig() {
      const config = await api("/v1/console/config");
      if (config.chat_enabled) {
        byId("chat-panel").hidden = false;
        byId("chat-provider").textContent = config.chat_provider;
      }
    }

    async function askChat(event) {
      event.preventDefault();
      const input = byId("chat-input");
      const message = input.value.trim();
      if (!message || !state.scope) return;
      appendChat("user", message, []);
      input.value = "";
      const history = state.chatHistory.slice(-20);
      state.chatHistory.push({ role: "user", content: message });
      try {
        const reply = await api(`/v1/scopes/${encodeURIComponent(state.scope)}/chat`, {
          method: "POST",
          body: JSON.stringify({ message, history })
        });
        appendChat("assistant", reply.answer, reply.evidence);
        state.chatHistory.push({ role: "assistant", content: reply.answer });
      } catch (error) {
        appendChat("assistant", `Chat error: ${error.message}`, []);
      }
    }

    function appendChat(role, content, evidence) {
      const item = document.createElement("li");
      item.className = `chat-message ${role}`;
      const chips = evidence?.length ? `<div class="evidence">${evidence.map((trace) =>
        `<button type="button" class="evidence-chip" data-subjects="${escapeHtml((trace.subject_keys || []).join(","))}"
          title="${escapeHtml(trace.error ? `Error: ${trace.error}` : `Sources: ${(trace.source_ids || []).join(", ") || "none"}`)}">
          ${trace.error ? "错误/Error" : "依据/Evidence"} · ${escapeHtml(trace.name)} ${escapeHtml(JSON.stringify(trace.args))}
        </button>`).join("")}</div>` : "";
      item.innerHTML = `<p>${escapeHtml(content)}</p>${chips}`;
      byId("chat-log").append(item);
      item.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function highlightSubjects(subjects) {
      const keys = new Set(subjects.split(",").filter(Boolean));
      document.querySelectorAll(".matter-button").forEach((card) => {
        card.classList.remove("flash");
        if (keys.has(card.dataset.subject)) {
          void card.offsetWidth;
          card.classList.add("flash");
          card.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    }

    byId("scope-select").addEventListener("change", (event) => selectActiveScope(event.target.value));
    byId("scope-list").addEventListener("click", (event) => {
      const button = event.target.closest("[data-scope]");
      if (button) selectActiveScope(button.dataset.scope);
    });
    byId("matter-list").addEventListener("click", (event) => {
      const button = event.target.closest("[data-subject]");
      if (button) loadDetail(button.dataset.subject);
    });
    byId("matter-detail").addEventListener("click", (event) => {
      const button = event.target.closest(".correct-value");
      if (button) openCorrection(button);
    });
    byId("chat-log").addEventListener("click", (event) => {
      const chip = event.target.closest(".evidence-chip");
      if (chip) highlightSubjects(chip.dataset.subjects);
    });
    byId("refresh-scopes").addEventListener("click", () => loadScopes());
    byId("refresh-matters").addEventListener("click", loadMatters);
    byId("load-sample").addEventListener("click", () => {
      byId("feed-scope").value = "demo";
      byId("feed-text").value = [
        "Dana Reyes: I own the octo-org Console launch and its status is in progress.",
        "Dana Reyes: The REST scope browser is connected.",
        "Dana Reyes: The next step is to finish the correction demo by August 5."
      ].join("\n");
      byId("feed-status").textContent = "Fictional sample loaded; Extract uses the packaged fixture gateway, so no key is needed.";
    });
    byId("extract-feed").addEventListener("click", extractFeed);
    byId("query-kind").addEventListener("change", updateQueryFields);
    byId("query-form").addEventListener("submit", runQuery);
    byId("toggle-json").addEventListener("click", () => {
      const raw = byId("query-json");
      raw.hidden = !raw.hidden;
      byId("query-human").hidden = !raw.hidden;
      byId("toggle-json").textContent = raw.hidden ? "Show raw JSON" : "Show human view";
    });
    byId("correction-form").addEventListener("submit", submitCorrection);
    byId("cancel-correction").addEventListener("click", () => byId("correction-dialog").close());
    byId("chat-form").addEventListener("submit", askChat);

    updateQueryFields();
    Promise.all([loadScopes(), loadChatConfig()]).catch((error) => {
      byId("scope-list").innerHTML = `<li class="error-box">${escapeHtml(error.message)}</li>`;
    });
  </script>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; connect-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'self'">
  <title>Matterhorn Console</title>
  <style>
    :root {
      color-scheme: light dark;
      --paper: #f3efe4;
      --sheet: #fbf9f2;
      --soft: #eee8d9;
      --rule: #d6cfbd;
      --rule-strong: #b9af96;
      --ink: #29251d;
      --muted: #6c6554;
      --faint: #958d78;
      --red: #a63227;
      --red-soft: #f3dfdb;
      --green: #2f6648;
      --green-soft: #e0ebdf;
      --amber: #87651c;
      --amber-soft: #f1e7c9;
      --serif: ui-serif, Georgia, "Times New Roman", serif;
      --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #1c1913;
        --sheet: #252119;
        --soft: #2c281f;
        --rule: #3c362a;
        --rule-strong: #514936;
        --ink: #ebe4d3;
        --muted: #aaa18a;
        --faint: #817962;
        --red: #e38679;
        --red-soft: #45251f;
        --green: #8ac6a4;
        --green-soft: #21362b;
        --amber: #d9b45c;
        --amber-soft: #3d3115;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 14px/1.5 var(--sans);
      overflow-wrap: anywhere;
    }
    button, input, select, textarea { color: inherit; font: inherit; }
    a { color: var(--green); text-underline-offset: .18em; }
    [hidden] { display: none !important; }
    .shell { width: min(112rem, calc(100% - 1.5rem)); margin: 0 auto; padding: 1rem 0 2.5rem; }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: .7rem .2rem;
      border-top: 3px double var(--rule-strong);
      border-bottom: 3px double var(--rule-strong);
      margin-bottom: 1rem;
    }
    h1, h2, h3, p { margin-top: 0; }
    h1 { margin-bottom: .05rem; font: 700 24px var(--serif); }
    h2 { margin-bottom: .15rem; font: 700 17px var(--serif); }
    h3 { margin-bottom: .2rem; font: 700 14px var(--serif); }
    .eyebrow {
      margin-bottom: .12rem;
      color: var(--faint);
      font: 700 10px var(--sans);
      letter-spacing: .17em;
      text-transform: uppercase;
    }
    .lede, .muted, .help { color: var(--muted); }
    .lede { margin-bottom: 0; font: italic 13px var(--serif); }
    .help { margin: .25rem 0 0; font-size: 11.5px; }
    .top-status { display: flex; align-items: center; gap: .45rem; font: 11px var(--mono); color: var(--muted); }
    .product {
      display: grid;
      grid-template-columns: minmax(18rem, 22rem) minmax(34rem, 1fr) minmax(19rem, 25rem);
      gap: 1rem;
      align-items: start;
    }
    .rail, .wall { min-width: 0; display: grid; gap: .8rem; align-content: start; }
    .rail-head {
      display: flex;
      gap: .55rem;
      align-items: baseline;
      border-bottom: 1.5px solid var(--ink);
      padding: 0 .1rem .3rem;
    }
    .rail-head strong { font: italic 700 16px var(--serif); }
    .rail-head span { font: 700 11px var(--sans); letter-spacing: .16em; text-transform: uppercase; }
    .sheet {
      min-width: 0;
      background: var(--sheet);
      border: 1px solid var(--rule);
      box-shadow: 2px 3px 0 rgb(40 35 27 / 6%);
      padding: .9rem 1rem;
    }
    .sheet-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: .7rem;
      margin-bottom: .65rem;
    }
    .sheet-head p { margin-bottom: 0; }
    details.sheet > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      gap: .8rem;
      font: 700 16px var(--serif);
    }
    details.sheet > summary::-webkit-details-marker { display: none; }
    details.sheet > summary::after { content: "open"; color: var(--faint); font: italic 11px var(--serif); }
    details.sheet[open] > summary::after { content: "close"; }
    .form-stack { display: grid; gap: .65rem; }
    .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem .7rem; }
    .span-two { grid-column: span 2; }
    label {
      display: block;
      margin-bottom: .18rem;
      color: var(--faint);
      font: 700 10px var(--sans);
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    input, select, textarea {
      width: 100%;
      background: transparent;
      border: 0;
      border-bottom: 1.5px solid var(--rule-strong);
      border-radius: 0;
      outline: none;
      padding: .3rem .05rem;
      font: 12.5px var(--mono);
    }
    select { border: 1px solid var(--rule-strong); background: var(--sheet); padding: .34rem .4rem; }
    textarea {
      min-height: 7rem;
      resize: vertical;
      line-height: 1.62em;
      font: 13px var(--serif);
      background-image: repeating-linear-gradient(transparent, transparent 1.55em, var(--rule) 1.55em, var(--rule) calc(1.55em + 1px));
    }
    input:focus, select:focus, textarea:focus { border-color: var(--ink); }
    input[type="checkbox"] { width: auto; accent-color: var(--ink); }
    input[type="file"] { font-size: 11px; color: var(--muted); }
    .check { display: flex; gap: .45rem; align-items: center; min-height: 2rem; color: var(--muted); font: 11.5px var(--mono); }
    .buttons { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .42rem; }
    .button {
      cursor: pointer;
      border: 1.5px solid var(--ink);
      border-radius: 0;
      background: var(--ink);
      color: var(--sheet);
      padding: .4rem .7rem;
      font: 700 10px var(--sans);
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    .button.secondary { background: transparent; color: var(--ink); }
    .button.quiet { border-color: var(--rule-strong); background: transparent; color: var(--muted); }
    .button.danger { border-color: var(--red); background: transparent; color: var(--red); }
    .button:disabled { opacity: .45; cursor: not-allowed; }
    .badge, .scope-chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--rule-strong);
      background: transparent;
      color: var(--muted);
      padding: .12rem .42rem;
      font: 700 10px var(--sans);
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .badge { border-width: 2px; border-color: var(--green); color: var(--green); rotate: -1deg; }
    .badge.danger { border-color: var(--red); color: var(--red); }
    .status-line { margin: .55rem 0 0; font: 11.5px var(--mono); color: var(--muted); }
    .status-line.success { color: var(--green); }
    .status-line.error { color: var(--red); }
    .memory-rule { margin: .25rem 0 0; color: var(--green); font: italic 11.5px var(--serif); }
    .account-list { list-style: none; margin: 0 0 .75rem; padding: 0; display: grid; gap: .55rem; }
    .account-row { border-left: 2px solid var(--rule-strong); padding: .1rem 0 .15rem .65rem; }
    .account-title { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; }
    .account-title strong { font: 700 13px var(--serif); }
    .account-provider { color: var(--green); font: 700 10px var(--mono); text-transform: uppercase; }
    .account-meta { display: grid; grid-template-columns: auto 1fr; gap: .1rem .45rem; margin: .28rem 0 .45rem; font: 10.5px var(--mono); }
    .account-meta dt { color: var(--faint); }
    .account-meta dd { margin: 0; }
    .account-actions { display: flex; flex-wrap: wrap; gap: .3rem; }
    .account-actions .button { padding: .25rem .45rem; font-size: 9px; }
    .filter-bar { display: flex; flex-wrap: wrap; gap: .38rem; align-items: center; }
    .filter-chip {
      cursor: pointer;
      border: 1px solid var(--rule-strong);
      background: var(--sheet);
      color: var(--muted);
      padding: .25rem .55rem;
      font: 11px var(--mono);
    }
    .filter-chip.active { border-color: var(--ink); background: var(--ink); color: var(--sheet); }
    .focus-toggle { display: inline-flex; border: 1px solid var(--rule-strong); }
    .focus-toggle .filter-chip { border: 0; border-right: 1px solid var(--rule-strong); }
    .focus-toggle .filter-chip:last-child { border-right: 0; }
    .matter-wall { display: grid; gap: .75rem; }
    .matter-group { padding: 0; overflow: hidden; }
    .matter-group-header {
      cursor: pointer; width: 100%; display: flex; justify-content: space-between;
      align-items: baseline; gap: .8rem; padding: .65rem .85rem; border: 0;
      border-bottom: 1.5px solid var(--ink); background: transparent; color: inherit;
      text-align: left;
    }
    .matter-group-header strong { font: 700 17px var(--serif); }
    .matter-group-header span { color: var(--muted); font: 10.5px var(--mono); }
    .matter-group.collapsed .matter-group-header { border-bottom: 0; }
    .matter-group.collapsed .matter-group-body { display: none; }
    .matter-rows { display: grid; }
    .matter-row {
      cursor: pointer;
      position: relative;
      width: 100%;
      text-align: left;
      display: grid;
      grid-template-columns: auto minmax(11rem, 1.15fr) minmax(8rem, 1fr) minmax(8rem, .8fr) minmax(12rem, 1.25fr);
      gap: .6rem;
      align-items: center;
      background: transparent;
      color: var(--ink);
      border: 0;
      border-bottom: 1px solid var(--rule);
      padding: .65rem .85rem;
    }
    .matter-row:hover, .matter-row.active { background: var(--soft); box-shadow: inset 3px 0 0 var(--ink); }
    .matter-row.archived { opacity: .58; }
    .matter-row-title { min-width: 0; }
    .matter-row-title strong { display: block; margin-top: .2rem; font: 700 15px var(--serif); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .matter-row-summary, .matter-row-blocker { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font: 12px var(--serif); color: var(--muted); }
    .matter-row-blocker { color: var(--red); font-weight: 700; }
    .matter-row-meta { min-width: 0; display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: .25rem .4rem; color: var(--muted); font: 10px var(--mono); }
    .matter-row-meta .conv-chip { margin-left: 0; max-width: 8.5rem; }
    .row-label { display: block; color: var(--faint); font: 700 8px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
    .next-chip { max-width: 11rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .archive-drawer { background: var(--soft); }
    .archive-drawer > summary { cursor: pointer; list-style: none; padding: .42rem .85rem; color: var(--faint); font: italic 11px var(--serif); }
    .archive-drawer > summary::-webkit-details-marker { display: none; }
    .archive-drawer > summary::before { content: "+ "; font: 10px var(--mono); }
    .archive-drawer[open] > summary::before { content: "− "; }
    .today-strip { display: flex; gap: .45rem; align-items: stretch; overflow-x: auto; padding: .65rem .75rem; }
    .today-heading { flex: 0 0 auto; padding-right: .65rem; border-right: 2px double var(--rule-strong); font: 700 16px var(--serif); }
    .today-entries { display: flex; gap: .45rem; min-width: 0; }
    .today-entry { cursor: pointer; flex: 0 0 min(18rem, 66vw); border: 1px solid var(--rule); background: transparent; color: inherit; padding: .42rem .55rem; text-align: left; }
    .today-entry:hover { border-color: var(--ink); }
    .today-entry strong, .today-entry span:last-child { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .today-entry strong { margin: .15rem 0 .08rem; font: 700 12px var(--serif); }
    .today-entry span:last-child { color: var(--muted); font: 10.5px var(--mono); }
    .worth-knowing-lines { display: grid; gap: .3rem; padding: .55rem 0; border-bottom: 1px solid var(--rule); }
    .brief-group-line { display: grid; grid-template-columns: minmax(7rem, .45fr) auto minmax(10rem, 1.5fr); gap: .55rem; padding: .38rem 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
    .brief-group-counts, .quiet-line { color: var(--faint); font: 10px var(--mono); }
    .brief-title { cursor: pointer; border: 0; border-bottom: 1px dotted var(--rule-strong); background: none; color: inherit; padding: 0; font: 12px var(--serif); }
    .quiet-fold { margin-top: .45rem; }
    .quiet-fold summary { cursor: pointer; }
    .hot-flag { color: var(--red); font-weight: 700; text-transform: uppercase; }
    #detail-dialog { width: min(34rem, calc(100vw - 3rem)); max-height: min(78vh, 40rem); overflow: auto; }
    .detail-head { display: flex; justify-content: space-between; align-items: flex-start; gap: .8rem; margin-bottom: .3rem; }
    .detail-head h2 { margin: 0; font-size: 19px; }
    .detail-close {
      flex: 0 0 auto; cursor: pointer; background: none; border: 1px solid var(--rule-strong);
      font: 700 10px inherit; letter-spacing: .1em; text-transform: uppercase;
      padding: .22rem .55rem; color: inherit;
    }
    .detail-values { list-style: none; margin: .6rem 0 0; padding: 0; }
    .detail-values li {
      display: grid; grid-template-columns: minmax(6rem, auto) minmax(0, 1fr) auto;
      gap: .55rem; align-items: baseline; padding: .5rem 0; border-bottom: 1px solid var(--rule);
    }
    .detail-values li:last-child { border-bottom: 0; }
    .detail-values .evidence {
      font-size: 10.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
      display: block;
    }
    .matter-row.flash { animation: flash 1.15s ease; }
    @keyframes flash { 0% { background: var(--amber-soft); } 100% { background: var(--sheet); } }
    .stamp-group { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .3rem; }
    .stamp {
      border: 2px solid var(--green);
      color: var(--green);
      padding: .05rem .34rem;
      rotate: -2deg;
      font: 700 9px var(--sans);
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .stamp.blocked, .stamp.overdue { border-color: var(--red); color: var(--red); }
    .stamp.updated { border-width: 1px; border-color: var(--amber); color: var(--amber); rotate: 1deg; opacity: .88; }
    .review-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
    .review-item { border-top: 1px solid var(--rule-strong); padding-top: .6rem; }
    .review-item:first-child { border-top: 0; padding-top: 0; }
    .review-summary { margin: .28rem 0 .45rem; color: var(--muted); font: 12px var(--serif); }
    .review-actions { display: flex; flex-wrap: wrap; gap: .3rem; }
    .review-actions .button { padding: .28rem .45rem; font-size: 9px; }
    .time-tree { border-top: 1px solid var(--rule-strong); margin-top: .8rem; padding-top: .7rem; }
    .treewrap { overflow-x: auto; }
    .time-tree-svg { width: 100%; min-width: 640px; display: block; margin: .3rem 0 .5rem; }
    .time-tree-svg text { font: 11px ui-monospace, Menlo, monospace; fill: var(--ink); }
    .time-tree-svg .tree-axis { fill: var(--faint); font-size: 10px; }
    .time-tree-svg .tree-root { font: 600 13px inherit; }
    .time-tree-svg .tree-title { font-weight: 600; font-size: 12.5px; }
    .time-tree-svg .tree-meta { fill: var(--muted); font-size: 10px; }
    .time-tree-svg .tree-bleed { fill: var(--red); font-weight: 700; font-size: 11px; }
    .time-tree-svg .tree-node { cursor: pointer; }
    .time-tree-svg .tree-node:hover rect { stroke-width: 2.2; }
    .mini-tree { display: block; width: min(240px, 100%); height: 14px; margin-top: .28rem; }
    .mini-tree line { stroke: var(--rule-strong); stroke-width: 1.4; }
    .expand-toggle { cursor: pointer; user-select: none; }
    .expand-toggle:hover { border-color: var(--ink); color: var(--ink); }
    .project-deck { margin-bottom: .9rem; }
    .deck-header { display: flex; justify-content: space-between; align-items: baseline;
      border-bottom: 1px solid var(--rule-strong); padding: .55rem .85rem; }
    .deck-header span { color: var(--faint); font: 10.5px var(--mono); }
    .project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: .7rem; padding: .8rem .85rem; }
    .project-card { border: 1px solid var(--rule-strong); background: var(--sheet); padding: .7rem .8rem .55rem; cursor: pointer; display: flex; flex-direction: column; gap: .35rem; }
    .project-card.unseen { border-left: 3px solid var(--amber); }
    .project-card.expanded { grid-column: 1 / -1; }
    .project-card header { display: flex; align-items: center; gap: .4rem; }
    .project-card .pin-toggle { margin-left: auto; border: 0; background: none; cursor: pointer; color: var(--faint); font-size: 14px; padding: 0 .1rem; }
    .project-card .pin-toggle.pinned { color: var(--amber); }
    .project-title { font-size: 1.02rem; font-weight: 600; margin: 0; cursor: pointer; }
    .project-title:hover { text-decoration: underline; }
    .project-progress { height: 5px; background: var(--soft); border: 1px solid var(--rule); }
    .project-progress span { display: block; height: 100%; background: var(--green); }
    .project-count { color: var(--muted); font: 10.5px var(--mono); margin: 0; }
    .project-blockers { color: var(--red); font: 11px var(--mono); margin: 0; }
    .project-next { color: var(--muted); font: 10.5px var(--mono); margin: 0; }
    .project-card footer { color: var(--faint); font: 10px var(--mono); margin-top: auto; text-align: right; }
    .project-card .child-rows { margin-left: .4rem; }
    .gather-scope { border-top: 1px solid var(--rule); padding-top: .35rem; }
    .gather-scope-label { color: var(--faint); font: 10px var(--mono); margin-right: .35rem; }
    .gather-member-chip { border: 1px solid var(--rule); background: var(--soft); color: var(--ink); cursor: pointer; font: 10px var(--mono); margin: .12rem .18rem .12rem 0; padding: .12rem .28rem; }
    .gather-member-chip:hover { border-color: var(--rule-strong); }
    .others-drawer > summary { cursor: pointer; padding: .6rem .85rem; font-weight: 600;
      border: 1px solid var(--rule); background: var(--sheet); list-style: none; }
    .others-drawer > summary::before { content: "▸ "; color: var(--faint); }
    .others-drawer[open] > summary::before { content: "▾ "; }
    .child-rows { border-left: 2px solid var(--rule-strong); margin: 0 0 .35rem 1.35rem; }
    .child-row { display: flex; align-items: baseline; gap: .55rem; width: calc(100% - 1.35rem);
      background: none; border: 0; border-bottom: 1px dotted var(--rule); cursor: pointer;
      text-align: left; padding: .32rem .4rem; font: 12.5px var(--serif); color: var(--ink); }
    .child-row:hover { background: var(--soft); }
    .child-row .child-elbow { color: var(--faint); font: 11px var(--mono); }
    .child-row strong { font-weight: 600; }
    .child-row time { margin-left: auto; color: var(--faint); font: 10px var(--mono); }
    .time-tree-list { list-style: none; margin: .45rem 0; padding: 0; display: grid; gap: .3rem; }
    .time-tree-node { display: flex; align-items: center; gap: .35rem; }
    .tree-link { border: 0; border-bottom: 1px dotted var(--rule-strong); background: none; color: inherit; padding: 0; cursor: pointer; font: 12px var(--serif); }
    .structure-controls { display: grid; gap: .65rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); margin-top: .7rem; }
    .overdue { color: var(--red); font-weight: 700; }
    .empty { color: var(--faint); font: italic 13px var(--serif); }
    .detail-values { list-style: none; margin: 0; padding: 0; }
    .detail-value {
      display: grid;
      grid-template-columns: 7rem 1fr auto;
      gap: .55rem;
      align-items: baseline;
      padding: .48rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .predicate { color: var(--faint); font: 700 9.5px var(--sans); letter-spacing: .1em; text-transform: uppercase; }
    .correct-value { cursor: pointer; border: 0; background: none; color: var(--muted); text-decoration: underline dotted; font: italic 12px var(--serif); }
    .detail-aliases { margin: .2rem 0 .7rem; color: var(--muted); font: italic 12px var(--serif); }
    .detail-handles { display: flex; flex-wrap: wrap; gap: .3rem; margin: .25rem 0 .7rem; }
    .handle-chip { padding: .12rem .38rem; border: 1px solid var(--rule-strong); border-radius: 2px; background: var(--soft); font: 10px var(--mono); }
    .timeline-panel { margin-top: .9rem; padding-top: .75rem; border-top: 2px double var(--rule); }
    .timeline-panel h3 { margin: 0 0 .55rem; font-size: 14px; }
    .matter-timeline { list-style: none; margin: 0; padding: 0 0 0 .7rem; border-left: 1px solid var(--rule-strong); }
    .timeline-entry { position: relative; display: grid; grid-template-columns: 7.6rem minmax(0, 1fr); gap: .65rem; padding: .15rem 0 .75rem .65rem; }
    .timeline-entry::before { content: ""; position: absolute; left: -.92rem; top: .38rem; width: .36rem; height: .36rem; border: 1px solid var(--ink); border-radius: 50%; background: var(--sheet); }
    .timeline-date { color: var(--faint); font: 10px var(--mono); }
    .timeline-value { margin-top: .12rem; font: 13px var(--serif); }
    .timeline-source { margin-top: .28rem; color: var(--muted); font: 10.5px/1.35 var(--mono); }
    .timeline-source strong { color: var(--ink); font-weight: 700; }
    .conv-chip { display: inline-block; margin-left: .45rem; padding: 0 .35rem; border: 1px solid var(--rule); border-radius: 2px; color: var(--muted); font: 9.5px var(--mono); vertical-align: middle; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
    .conv-chip.repeat { opacity: .45; }
    #stale-banner { position: fixed; top: 0; left: 0; right: 0; z-index: 60; display: none; padding: .5rem 1rem; background: var(--ink); color: var(--sheet); font: 12px var(--mono); text-align: center; cursor: pointer; }
    #stale-banner.show { display: block; }
    .clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; cursor: pointer; }
    .clamp.clamp-value { -webkit-line-clamp: 4; }
    .clamp.open { display: block; -webkit-line-clamp: unset; overflow: visible; }
    .clamp:not(.open)::after { content: ""; }
    .merge-panel { margin-top: .85rem; padding-top: .75rem; border-top: 2px double var(--rule); }
    .merge-panel h3 { margin: 0 0 .45rem; font-size: 14px; }
    .related-panel { margin-top: .85rem; padding-top: .75rem; border-top: 2px double var(--rule); }
    .related-list { list-style: none; margin: 0; padding: 0; display: grid; }
    .related-item { cursor: pointer; display: flex; align-items: baseline; gap: .5rem; width: 100%; border: 0; border-bottom: 1px solid var(--rule); background: transparent; color: inherit; padding: .42rem 0; text-align: left; }
    .related-item strong { font: 700 13px var(--serif); }
    .related-via { margin-left: auto; color: var(--faint); font: 9px var(--mono); }
    .evidence { color: var(--muted); font: 10.5px var(--mono); }
    .evidence-chip { cursor: pointer; border: 0; border-bottom: 1px solid var(--green); background: none; color: var(--green); padding: 0; font: 10.5px var(--mono); }
    .hub-strip { display: grid; grid-template-columns: minmax(15rem, .8fr) minmax(20rem, 1.4fr); gap: .7rem; }
    .connection-list, .activity-list, .chat-log { list-style: none; margin: 0; padding: 0; }
    .connection-list { display: grid; gap: .35rem; }
    .connection-item { border-bottom: 1px solid var(--rule); padding-bottom: .28rem; font: 11px var(--mono); }
    .activity-list { max-height: 11rem; overflow: auto; }
    .activity-item { border-bottom: 1px solid var(--rule); padding: .35rem 0; }
    .activity-item strong { font: 700 12.5px var(--serif); }
    .activity-meta { color: var(--faint); font: 10px var(--mono); }
    .raw-stream-list { list-style: none; margin: .7rem 0 0; padding: 0; max-height: 34rem; overflow: auto; }
    .raw-stream-item {
      display: grid;
      grid-template-columns: 5.5rem auto minmax(7rem, .65fr) minmax(5rem, .45fr) minmax(10rem, 1.8fr);
      gap: .45rem;
      align-items: baseline;
      min-height: 1.45rem;
      padding: .22rem 0;
      border-bottom: 1px solid var(--rule);
      font: 10.5px/1.35 var(--mono);
    }
    .raw-stream-time, .raw-stream-conversation { color: var(--faint); }
    .raw-stream-conversation, .raw-stream-sender, .raw-stream-content { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .raw-stream-sender { color: var(--green); font-weight: 700; }
    .chat-log { max-height: 22rem; overflow: auto; }
    .chat-message { border-bottom: 1px solid var(--rule); padding: .5rem 0; }
    .chat-message p { margin: 0 0 .25rem; white-space: pre-wrap; font: 13.5px var(--serif); }
    .chat-message.user p { color: var(--muted); font-style: italic; }
    .chat-form { display: grid; grid-template-columns: 1fr auto; gap: .45rem; align-items: end; margin-top: .6rem; }
    .result-row { border-bottom: 1px solid var(--rule); padding: .45rem 0; }
    pre { max-height: 16rem; overflow: auto; white-space: pre-wrap; background: var(--soft); border: 1px solid var(--rule); padding: .6rem; font: 11px var(--mono); }
    .error-box { border: 1px solid var(--red); color: var(--red); padding: .5rem; margin-top: .5rem; }
    dialog { width: min(32rem, calc(100% - 2rem)); background: var(--sheet); color: var(--ink); border: 1.5px solid var(--ink); padding: 1rem; }
    dialog::backdrop { background: rgb(30 25 18 / 40%); }
    @media (max-width: 85rem) {
      .product { grid-template-columns: minmax(18rem, 21rem) minmax(30rem, 1fr); }
      .rail-right { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .rail-right > .rail-head { grid-column: 1 / -1; }
    }
    @media (max-width: 60rem) {
      .product { grid-template-columns: 1fr; }
      .rail-right { grid-column: auto; grid-template-columns: 1fr; }
      .rail-right > .rail-head { grid-column: auto; }
      .hub-strip { grid-template-columns: 1fr; }
      .raw-stream-item { grid-template-columns: 5rem auto minmax(7rem, .7fr) minmax(9rem, 1.5fr); }
      .raw-stream-sender { display: none; }
      .matter-row { grid-template-columns: auto minmax(10rem, 1fr) minmax(8rem, 1fr); }
      .matter-row-blocker, .matter-row-meta { grid-column: 2 / -1; justify-content: flex-start; }
    }
    @media (max-width: 38rem) {
      .shell { width: calc(100% - .7rem); }
      .topbar { align-items: flex-start; flex-direction: column; }
      .field-grid { grid-template-columns: 1fr; }
      .span-two { grid-column: auto; }
      .matter-row { grid-template-columns: auto minmax(0, 1fr); align-items: start; }
      .matter-row-summary, .matter-row-blocker, .matter-row-meta { grid-column: 1 / -1; }
    }
  </style>
</head>
<body>
  <div id="stale-banner" role="button">界面已更新 — 点击刷新加载新版本</div>
  <div class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Personal matter ledger · loopback REST client</p>
        <h1>Matterhorn Console</h1>
        <p class="lede">Bring every source into one evidence-backed wall. Configure left; consume right.</p>
      </div>
      <div class="top-status"><span class="badge" id="hub-state">live</span><span id="top-summary">Reading ledger…</span></div>
    </header>

    <main class="product">
      <aside class="rail rail-left" aria-label="Sources and configuration">
        <div class="rail-head"><strong>1</strong><span>Sources & configuration</span></div>

        <section class="sheet" aria-labelledby="mail-title">
          <div class="sheet-head">
            <div><p class="eyebrow">Multiple accounts</p><h2 id="mail-title">Mailboxes</h2></div>
            <span class="badge" id="mail-stamp">0 accounts</span>
          </div>
          <ul class="account-list" id="mail-account-list"><li class="empty">No mailboxes configured.</li></ul>
          <details id="mail-sheet">
            <summary>Add mailbox</summary>
            <form class="form-stack" id="mail-config-form" style="margin-top:.7rem">
              <div class="field-grid">
                <div>
                  <label for="mail-name">Name / account id</label>
                  <input id="mail-name" maxlength="512" placeholder="personal">
                </div>
                <div>
                  <label for="mail-provider">Provider</label>
                  <select id="mail-provider">
                    <option value="gmail">gmail</option><option value="outlook">outlook</option>
                    <option value="icloud">icloud</option><option value="qq">qq</option>
                    <option value="163">163</option><option value="manual">manual</option>
                  </select>
                </div>
                <div class="span-two">
                  <label for="mail-account">Account</label>
                  <input id="mail-account" type="email" maxlength="320" autocomplete="username" required>
                </div>
                <div>
                  <label for="mail-host">IMAP host</label>
                  <input id="mail-host" maxlength="255" required>
                </div>
                <div>
                  <label for="mail-port">Port</label>
                  <input id="mail-port" type="number" min="1" max="65535" required>
                </div>
                <div>
                  <label for="mail-folder">Folder</label>
                  <input id="mail-folder" value="INBOX" maxlength="512" required>
                </div>
                <div>
                  <label for="mail-scope">Target scope</label>
                  <input id="mail-scope" maxlength="120" placeholder="personal" required>
                </div>
                <div>
                  <label for="mail-interval">Schedule</label>
                  <select id="mail-interval"><option value="off">off</option><option value="15min">15 min</option><option value="1h">1 hour</option><option value="6h">6 hours</option></select>
                </div>
                <div>
                  <label for="mail-initial-window">First pull</label>
                  <input id="mail-initial-window" type="number" min="1" value="50" required>
                </div>
                <div class="check"><input id="mail-ssl" type="checkbox" checked><span>SSL / implicit TLS</span></div>
                <div class="span-two">
                  <label for="mail-password">App password / authorization code</label>
                  <input id="mail-password" type="password" autocomplete="new-password">
                  <p class="memory-rule">Process memory only. Never written to TOML, logs, or GET responses.</p>
                </div>
              </div>
              <div class="buttons"><button class="button" type="submit">Add mailbox</button></div>
            </form>
          </details>
          <p class="status-line" id="mail-message" role="status"></p>
        </section>

        <details class="sheet" id="ai-sheet" open>
          <summary><span>AI · write gateway + chat</span></summary>
          <form class="form-stack" id="ai-form" style="margin-top:.7rem">
            <div class="field-grid">
              <div>
                <label for="ai-provider">Provider</label>
                <select id="ai-provider"><option value="openai-compatible">openai-compatible</option><option value="anthropic">anthropic</option></select>
              </div>
              <div>
                <label for="ai-timeout">Timeout seconds</label>
                <input id="ai-timeout" type="number" min=".1" step=".1" value="60">
              </div>
              <div class="span-two">
                <label for="ai-base-url">Base URL</label>
                <input id="ai-base-url" value="https://api.openai.com/v1" required>
              </div>
              <div class="span-two">
                <label for="ai-model">Model</label>
                <input id="ai-model" required>
              </div>
              <div class="span-two">
                <label for="ai-key">API key</label>
                <input id="ai-key" type="password" autocomplete="new-password">
                <p class="memory-rule">Runtime Console config overrides environment. The key remains process-local.</p>
              </div>
            </div>
            <div class="buttons">
              <button class="button secondary" id="ai-test" type="button">Test</button>
              <button class="button" type="submit">Save AI</button>
            </div>
          </form>
          <p class="status-line" id="ai-status">Reading AI state…</p>
        </details>

        <details class="sheet" id="feed-sheet" open>
          <summary><span>Feed input</span></summary>
          <div class="form-stack" style="margin-top:.7rem">
            <div>
              <label for="feed-scope">Scope</label>
              <input id="feed-scope" value="personal" maxlength="120">
            </div>
            <div>
              <label for="feed-text">Chat, YAML/JSON, EML, or mbox</label>
              <textarea id="feed-text" maxlength="200000" placeholder="Dana Reyes: The octo-org release review is in progress."></textarea>
            </div>
            <div class="buttons"><button class="button quiet" id="load-sample" type="button">Load sample</button><button class="button" id="extract-feed" type="button">Extract</button></div>
            <div>
              <label for="feed-file">Upload file</label>
              <input id="feed-file" type="file" accept=".mbox,.eml,.yaml,.json">
              <div class="buttons"><button class="button secondary" id="upload-feed" type="button">Upload + extract</button></div>
            </div>
          </div>
          <p class="status-line" id="feed-status" role="status"></p>
          <pre id="feed-receipt" hidden></pre>
        </details>
      </aside>

      <section class="wall" aria-labelledby="wall-title">
        <div class="rail-head"><strong>2</strong><span>Unified matter wall</span></div>
        <section class="sheet">
          <div class="sheet-head">
            <div><p class="eyebrow">All scopes · deterministic read</p><h2 id="wall-title">Matters</h2></div>
            <div class="buttons">
              <span class="focus-toggle" id="focus-toggle" aria-label="Wall mode">
                <button type="button" class="filter-chip" data-wall-mode="focus">Focus</button>
                <button type="button" class="filter-chip" data-wall-mode="all">All</button>
              </span>
              <button class="button quiet" id="refresh-matters" type="button">Refresh</button>
            </div>
          </div>
          <div class="filter-bar" id="scope-list" aria-label="Scope filters"></div>
        </section>
        <section class="sheet today-strip" id="today-strip" aria-labelledby="today-title" hidden>
          <h2 class="today-heading" id="today-title">Today</h2>
          <div class="today-entries" id="today-entries"></div>
        </section>
        <div class="matter-wall" id="matter-list"><p class="empty">No matters yet.</p></div>
        <details class="sheet" id="raw-stream-panel" open>
          <summary><span>Raw stream</span></summary>
          <p class="help">Newest staged messages · follows the wall scope filter · zero-model read</p>
          <ul class="raw-stream-list" id="raw-stream-list"><li class="empty">No staged messages yet.</li></ul>
        </details>
        <details class="sheet" id="hub-overview" open>
          <summary><span>Activity & connections</span></summary>
          <div class="hub-strip" style="margin-top:.7rem">
            <section>
              <h3>Connections</h3>
              <ul class="connection-list" id="connection-list"><li class="empty">Reading inputs…</li></ul>
            </section>
            <section>
              <h3>Activity stream</h3>
              <ul class="activity-list" id="activity-list"><li class="empty">No projection changes yet.</li></ul>
            </section>
          </div>
        </details>
      </section>

      <aside class="rail rail-right" aria-label="Consumption">
        <div class="rail-head"><strong>3</strong><span>Consumption</span></div>
        <section class="sheet">
          <div class="sheet-head"><div><p class="eyebrow">Scoped tools</p><h2>Working scope</h2></div></div>
          <label for="chat-scope">Chat and query scope</label>
          <select id="chat-scope"><option value="">No scopes yet</option></select>
          <p class="help">Follows a single wall filter or the last-opened row.</p>
        </section>
        <section class="sheet" aria-labelledby="review-title">
          <div class="sheet-head">
            <div><p class="eyebrow">Human identity decision</p><h2 id="review-title">Review</h2></div>
            <span class="badge" id="review-count">0</span>
          </div>
          <ul class="review-list" id="review-list"><li class="empty">No cards awaiting review.</li></ul>
          <p class="status-line" id="review-status" role="status"></p>
        </section>
        <section class="sheet" id="chat-panel" aria-labelledby="chat-title" hidden>
          <div class="sheet-head">
            <div><h2 id="chat-title">Chat</h2><p class="muted">Provider reasoning over scoped deterministic tools</p></div>
            <span class="badge" id="chat-provider"></span>
          </div>
          <ul class="chat-log" id="chat-log"><li class="chat-message"><p>Ask about progress, ownership, due dates, history, or evidence.</p></li></ul>
          <form class="chat-form" id="chat-form">
            <input id="chat-input" maxlength="8000" placeholder="What needs attention?" autocomplete="off">
            <button class="button" type="submit">Ask</button>
          </form>
        </section>
        <section class="sheet" aria-labelledby="workbench-title">
          <div class="sheet-head"><div><h2 id="workbench-title">Query workbench</h2><p class="muted">Public zero-model read paths</p></div></div>
          <form class="form-stack" id="query-form">
            <div class="field-grid">
              <div>
                <label for="query-kind">Query</label>
                <select id="query-kind"><option value="current">current</option><option value="timeline">timeline</option><option value="at">at</option><option value="by-person">by-person</option></select>
              </div>
              <div id="query-subject-wrap">
                <label for="query-subject">Subject key</label>
                <input id="query-subject">
              </div>
              <div id="query-predicate-wrap">
                <label for="query-predicate">Predicate</label>
                <input id="query-predicate" value="status">
              </div>
              <div id="query-person-wrap" hidden>
                <label for="query-person">Person id</label>
                <input id="query-person">
              </div>
              <div class="span-two" id="query-instant-wrap" hidden>
                <label for="query-instant">At instant</label>
                <input id="query-instant" type="datetime-local">
              </div>
            </div>
            <div class="buttons"><button class="button" type="submit">Run query</button><button class="button secondary" id="toggle-json" type="button" disabled>Raw JSON</button></div>
          </form>
          <div id="query-human"></div>
          <pre id="query-json" hidden></pre>
        </section>
      </aside>
    </main>
  </div>

  <dialog id="detail-dialog">
    <div id="detail-dialog-body"></div>
  </dialog>

  <dialog id="correction-dialog">
    <form class="form-stack" id="correction-form">
      <div><p class="eyebrow">Human assertion · P8</p><h2>Correct current value</h2><p class="muted" id="correction-target"></p></div>
      <div><label for="correction-value">New value</label><textarea id="correction-value" required></textarea></div>
      <div><label for="correction-reason">Reason</label><textarea id="correction-reason" required></textarea></div>
      <div><label for="correction-sender">Your name</label><input id="correction-sender" required placeholder="Dana Reyes" autocomplete="name"></div>
      <div id="correction-error"></div>
      <div class="buttons"><button class="button" type="submit">Record correction</button><button class="button quiet" id="cancel-correction" type="button">Cancel</button></div>
    </form>
  </dialog>

  <script>
    "use strict";
    const state = {
      scopes: [], filter: "all", matters: [], layerProjects: [], detail: null, selected: "",
      chatScope: "", chatHistory: [], mailAccounts: [], ai: null,
      queryResult: null, activity: [], connections: null,
      reviews: [], reviewCount: 0, rawStream: [], streamNewestRecordId: null, assetVersion: null,
      brief: { needs_me: [], worth_knowing: [], groups: [], quiet: [] }, briefFingerprint: null,
      focusMode: true, groups: {}, scopeToGroup: {}, collapsedGroups: new Set(), openArchives: new Set(),
      expandedRoots: new Set(), othersOpen: false,
      pinnedProjects: new Set(JSON.parse(localStorage.getItem("matterhorn.console.pins") || "[]"))
    };
    const WALL_MODE_KEY = "matterhorn.console.wall.mode";
    const COLLAPSED_GROUPS_KEY = "matterhorn.console.groups.collapsed";
    const ACTIVE_STATUSES = new Set(["open", "in_progress", "blocked", "pending", "ready"]);
    const utf8 = new TextEncoder();
    const mailPresets = {
      gmail: { host: "imap.gmail.com", port: 993, ssl: true },
      outlook: { host: "outlook.office365.com", port: 993, ssl: true },
      icloud: { host: "imap.mail.me.com", port: 993, ssl: true },
      qq: { host: "imap.qq.com", port: 993, ssl: true },
      "163": { host: "imap.163.com", port: 993, ssl: true }
    };
    const byId = (id) => document.getElementById(id);
    const escapeHtml = (value) => String(value ?? "")
      .replaceAll("&", "&amp;").replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;").replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
    const jsonText = (value) => JSON.stringify(value, null, 2);
    const displayValue = (value) => typeof value === "string" ? value : jsonText(value);
    const compactValue = (value) => {
      if (Array.isArray(value)) return value.map((item) => compactValue(item)).join(", ");
      if (value && typeof value === "object") return value.display_name || value.name || value.id || JSON.stringify(value);
      return String(value ?? "—");
    };
    const gatherSubjectRef = (scope, subject) => [scope, subject].map((value) =>
      encodeURIComponent(value).replace(/[!'()*]/g, (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`)
    ).join(":");
    const api = async (path, options = {}) => {
      const isForm = options.body instanceof FormData;
      const response = await fetch(path, {
        ...options,
        headers: { ...(!isForm ? { "Content-Type": "application/json" } : {}), ...(options.headers || {}) }
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error?.message || `HTTP ${response.status}`);
      return payload;
    };
    const setStatus = (id, message, kind = "") => {
      const node = byId(id);
      node.className = `status-line ${kind}`;
      node.textContent = message;
    };
    const accountPath = (accountId, action = "") =>
      `/v1/connectors/mail/accounts/${encodeURIComponent(accountId)}${action}`;
    const seenStorageKey = (scope) => `matterhorn.console.seen.${scope}`;

    function restoreWallPreferences() {
      try {
        state.focusMode = localStorage.getItem(WALL_MODE_KEY) !== "all";
        const collapsed = JSON.parse(localStorage.getItem(COLLAPSED_GROUPS_KEY) || "[]");
        state.collapsedGroups = new Set(Array.isArray(collapsed) ? collapsed : []);
      } catch (_) {
        state.focusMode = true;
        state.collapsedGroups = new Set();
      }
      renderFocusToggle();
    }

    function renderFocusToggle() {
      document.querySelectorAll("[data-wall-mode]").forEach((button) => {
        const active = (button.dataset.wallMode === "focus") === state.focusMode;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    function setWallMode(mode) {
      state.focusMode = mode !== "all";
      const groups = groupOrder(state.matters);
      state.openArchives = state.focusMode ? new Set() : new Set(groups);
      try { localStorage.setItem(WALL_MODE_KEY, state.focusMode ? "focus" : "all"); } catch (_) { /* Optional preference. */ }
      renderFocusToggle();
      renderMatters();
    }

    function bytewise(left, right) {
      const a = utf8.encode(String(left));
      const b = utf8.encode(String(right));
      const length = Math.min(a.length, b.length);
      for (let index = 0; index < length; index += 1) {
        if (a[index] !== b[index]) return a[index] - b[index];
      }
      return a.length - b.length;
    }

    function groupForScope(scope) {
      return state.scopeToGroup[scope] || "other";
    }

    function groupOrder(matters) {
      const present = new Set(matters.map((matter) => groupForScope(matter.scope_id)));
      const configured = Object.keys(state.groups).filter((group) => group !== "other" && present.has(group));
      const extras = [...present].filter((group) => group !== "other" && !configured.includes(group)).sort(bytewise);
      return [...configured, ...extras, ...(present.has("other") ? ["other"] : [])];
    }

    function seenMatters(scope) {
      try {
        const value = JSON.parse(localStorage.getItem(seenStorageKey(scope)) || "{}");
        return value && typeof value === "object" && !Array.isArray(value) ? value : {};
      } catch (_) {
        return {};
      }
    }

    function isMatterUpdated(matter) {
      if (typeof matter.unseen === "boolean") return matter.unseen;
      if (!matter.updated_at) return false;
      const seenAt = seenMatters(matter.scope_id)[matter.subject_key];
      const updated = Date.parse(matter.updated_at);
      const seen = Date.parse(seenAt || "");
      return !Number.isFinite(seen) || (Number.isFinite(updated) && updated > seen);
    }

    function markMatterSeen(matter) {
      if (!matter?.updated_at) return;
      try {
        const seen = seenMatters(matter.scope_id);
        seen[matter.subject_key] = new Date().toISOString();
        localStorage.setItem(seenStorageKey(matter.scope_id), JSON.stringify(seen));
      } catch (_) {
        // Rendering and detail reads remain usable when browser storage is disabled.
      }
    }

    async function loadScopes(preferred = null) {
      state.scopes = await api("/v1/scopes");
      const desired = preferred && state.scopes.includes(preferred)
        ? preferred : (state.scopes.includes(state.chatScope) ? state.chatScope : (state.scopes[0] || ""));
      state.chatScope = desired;
      byId("chat-scope").innerHTML = state.scopes.length
        ? state.scopes.map((scope) => `<option value="${escapeHtml(scope)}">${escapeHtml(scope)}</option>`).join("")
        : '<option value="">No scopes yet</option>';
      byId("chat-scope").value = state.chatScope;
      renderScopeFilters();
      return state.scopes;
    }

    function renderScopeFilters() {
      const filters = ["all", ...state.scopes];
      byId("scope-list").innerHTML = filters.map((scope) =>
        `<button type="button" class="filter-chip ${state.filter === scope ? "active" : ""}" data-scope="${escapeHtml(scope)}">${escapeHtml(scope === "all" ? "All" : scope)}</button>`
      ).join("");
    }

    async function selectWallFilter(scope) {
      state.filter = scope;
      if (scope !== "all") setWorkingScope(scope);
      renderScopeFilters();
      await Promise.all([loadMatters(), loadRawStream()]);
    }

    function setWorkingScope(scope) {
      if (!scope || !state.scopes.includes(scope)) return;
      state.chatScope = scope;
      byId("chat-scope").value = scope;
    }

    async function loadMatters() {
      const query = state.filter === "all" ? "" : `?scope=${encodeURIComponent(state.filter)}`;
      const [visible, all] = await Promise.all([
        api(`/v1/matters${query}`),
        query ? api("/v1/matters") : Promise.resolve(null)
      ]);
      state.matters = visible;
      state.layerProjects = (all || visible).filter((matter) => matter.layer === 2);
      renderMatters();
      renderToday();
    }

    // The briefing surface (needs_me strip, worth-knowing, group rollups)
    // left the first screen on 2026-08-06 — user direction: the page leads
    // with core projects. /v1/console/brief keeps serving REST and CLI.

    function streamPath() {
      return state.filter === "all"
        ? "/v1/stream?limit=50"
        : `/v1/scopes/${encodeURIComponent(state.filter)}/stream?limit=50`;
    }

    async function loadRawStream() {
      state.rawStream = await api(streamPath());
      state.streamNewestRecordId = state.rawStream[0]?.record_id || null;
      renderRawStream();
    }

    function renderRawStream() {
      const shorten = (value) => value.length > 30
        ? `${value.slice(0, 14)}…${value.slice(-13)}` : value;
      byId("raw-stream-list").innerHTML = state.rawStream.length
        ? state.rawStream.map((item) => {
            const sentAt = new Date(item.sent_at);
            const time = Number.isNaN(sentAt.valueOf()) ? item.sent_at : sentAt.toLocaleTimeString();
            const content = String(item.content || "").replace(/\s+/g, " ").trim();
            return `<li class="raw-stream-item" title="${escapeHtml(item.record_id)}">
              <time class="raw-stream-time" datetime="${escapeHtml(item.sent_at)}">${escapeHtml(time)}</time>
              <span class="scope-chip">${escapeHtml(item.scope_id)}</span>
              <span class="raw-stream-conversation" title="${escapeHtml(item.container_id)}">${escapeHtml(shorten(item.container_id))}</span>
              <span class="raw-stream-sender">${escapeHtml(item.sender)}</span>
              <span class="raw-stream-content">${escapeHtml(content)}</span>
            </li>`;
          }).join("")
        : '<li class="empty">No staged messages match this scope filter.</li>';
    }

    async function pollRawStream() {
      const items = await api(streamPath());
      const newestRecordId = items[0]?.record_id || null;
      if (newestRecordId !== state.streamNewestRecordId) {
        state.rawStream = items;
        state.streamNewestRecordId = newestRecordId;
        renderRawStream();
      }
    }

    async function fetchReviews(scopes = state.scopes) {
      const batches = await Promise.all(scopes.map(async (scope) => {
        const items = await api(`/v1/scopes/${encodeURIComponent(scope)}/reviews`);
        return items.map((item) => ({ ...item, scope_id: scope }));
      }));
      return batches.flat().sort((left, right) => left.created_at.localeCompare(right.created_at)
        || left.review_id.localeCompare(right.review_id));
    }

    async function loadReviews() {
      state.reviews = await fetchReviews();
      state.reviewCount = state.reviews.length;
      renderReviews();
    }

    function renderReviews() {
      byId("review-count").textContent = state.reviewCount;
      byId("review-list").innerHTML = state.reviews.length
        ? state.reviews.map((item) => {
            const card = item.card_json || {};
            const summary = card.progress || card.status || card.next_step || "No summary supplied.";
            const candidates = (item.candidates_json || []).map((candidate) => candidate.action === "attach_subgoal"
              ? `<button type="button" class="button secondary" data-review-action="attach_subgoal" data-review-id="${escapeHtml(item.review_id)}" data-review-scope="${escapeHtml(item.scope_id)}" data-review-parent="${escapeHtml(candidate.parent_subject_key)}">Attach under ${escapeHtml(candidate.title)}</button>`
              : `<button type="button" class="button secondary" data-review-action="attach" data-review-id="${escapeHtml(item.review_id)}" data-review-scope="${escapeHtml(item.scope_id)}" data-review-subject="${escapeHtml(candidate.subject_key)}">Attach to ${escapeHtml(candidate.title)}</button>`
            ).join("");
            const identityActions = (item.reasons || []).includes("PARENT_SUGGESTION") ? "" : `<button type="button" class="button quiet" data-review-action="new" data-review-id="${escapeHtml(item.review_id)}" data-review-scope="${escapeHtml(item.scope_id)}">Create new</button><button type="button" class="button quiet" data-review-action="drop" data-review-id="${escapeHtml(item.review_id)}" data-review-scope="${escapeHtml(item.scope_id)}">Drop</button>`;
            return `<li class="review-item"><span class="scope-chip">${escapeHtml(item.scope_id)}</span><h3>${escapeHtml(card.title || "Untitled card")}</h3><p class="review-summary">${escapeHtml(summary)}</p><p class="help">${escapeHtml((item.reasons || []).join(" · "))}</p><div class="review-actions">${candidates}${identityActions}</div></li>`;
          }).join("")
        : '<li class="empty">No cards awaiting review.</li>';
    }

    async function resolveReview(button) {
      const action = button.dataset.reviewAction;
      const scope = button.dataset.reviewScope;
      const subject = button.dataset.reviewSubject || null;
      const parentSubject = button.dataset.reviewParent || null;
      const sender = localStorage.getItem("matterhorn.console.sender") || "Console operator";
      const now = new Date().toISOString();
      button.disabled = true;
      try {
        await api(`/v1/scopes/${encodeURIComponent(scope)}/reviews/${encodeURIComponent(button.dataset.reviewId)}/resolve`, {
          method: "POST",
          body: JSON.stringify({
            action,
            subject_key: subject,
            parent_subject_key: parentSubject,
            source_refs: [{
              source_id: `console:${crypto.randomUUID()}`,
              sent_at: now,
              sender,
              excerpt: action === "attach" ? `Console review attached this card to ${subject}.` : action === "attach_subgoal" ? `Console review attached this subgoal under ${parentSubject}.` : "Console review created a new matter."
            }]
          })
        });
        setStatus("review-status", "Review resolved.", "success");
        await Promise.all([loadReviews(), loadMatters(), loadActivity()]);
      } catch (error) {
        button.disabled = false;
        setStatus("review-status", error.message, "error");
      }
    }

    function flattenTree(node, result = []) {
      if (!node) return result;
      result.push(node);
      (node.children || []).forEach((child) => flattenTree(child, result));
      return result;
    }

    function statusTone(status) {
      const value = String(compactValue(status) || "").toLowerCase();
      if (!value || value === "open") return "var(--faint)";
      if (value === "blocked") return "var(--red)";
      if (["completed", "done", "resolved", "closed", "merged", "shipped"].includes(value)) return "var(--green)";
      return "var(--amber)";
    }

    function textWidth(label) {
      let width = 0;
      for (const ch of String(label)) width += ch.charCodeAt(0) > 255 ? 13.6 : 7.4;
      return width;
    }

    function timeTreeSvg(detail) {
      const graph = detail.graph || {};
      const node = graph.node || {};
      const children = (graph.children || []).slice().sort((left, right) =>
        new Date(left.birth_instant || 0) - new Date(right.birth_instant || 0));
      const decisions = node.decision_points || [];
      const stamps = [...children.map((child) => child.birth_instant), ...decisions.map((item) => item.at)]
        .filter(Boolean).map((value) => new Date(value).valueOf()).filter(Number.isFinite);
      if (!stamps.length) return "";
      let min = Math.min(...stamps), max = Math.max(...stamps);
      const pad = Math.max((max - min) * 0.08, 30 * 60 * 1000);
      min -= pad; max += pad;
      const W = 960, L = 24, R = 30, spineY = 44;
      const x = (value) => L + (new Date(value).valueOf() - min) / (max - min) * (W - L - R);
      const H = 84 + children.length * 58 + 36;
      const ticks = [];
      for (let index = 0; index <= 4; index += 1) {
        const instant = new Date(min + (max - min) * index / 4).toISOString();
        const tx = x(instant).toFixed(1);
        const anchor = index === 0 ? "start" : index === 4 ? "end" : "middle";
        ticks.push(`<line x1="${tx}" y1="${spineY + 12}" x2="${tx}" y2="${H - 30}" stroke="var(--rule)"/>` +
          `<text x="${tx}" y="${H - 14}" text-anchor="${anchor}" class="tree-axis">${escapeHtml(compactTime(instant))}</text>`);
      }
      const blockedKids = children.filter((child) =>
        String(compactValue(child.status) || "").toLowerCase() === "blocked" || (child.blocker || []).length);
      const bleed = blockedKids.length
        ? `<text x="${W - R}" y="${spineY - 18}" text-anchor="end" class="tree-bleed">⛔ 卡点上浮 · ${blockedKids.length} 个子目标受阻</text>` : "";
      const diamonds = decisions.filter((item) => item.at).map((item) => {
        const dx = x(item.at);
        return `<g><rect x="${(dx - 6).toFixed(1)}" y="${spineY - 6}" width="12" height="12" transform="rotate(45 ${dx.toFixed(1)} ${spineY})" fill="var(--ink)" stroke="var(--sheet)" stroke-width="1.5"/><title>◆ ${escapeHtml(compactValue(item.value))}</title></g>`;
      }).join("");
      const kids = children.map((kid, index) => {
        const bx = x(kid.birth_instant || min);
        const y = 82 + index * 58;
        const tone = statusTone(kid.status);
        const label = kid.title || kid.subject_key;
        const meta = `${compactValue(kid.status) || "open"}${(kid.blocker || []).length ? " · " + compactValue(kid.blocker) : ""} · ${compactTime(kid.birth_instant)}`;
        const bw = Math.min(420, 22 + textWidth(label));
        return `<g class="tree-node" data-tree-scope="${escapeHtml(detail.scope_id)}" data-tree-subject="${escapeHtml(kid.subject_key)}">
          <path d="M ${bx.toFixed(1)} ${spineY} L ${bx.toFixed(1)} ${y} L ${(bx + 14).toFixed(1)} ${y}" stroke="${tone}" stroke-width="1.6" fill="none"/>
          <circle cx="${bx.toFixed(1)}" cy="${spineY}" r="3.4" fill="${tone}"/>
          <rect x="${(bx + 14).toFixed(1)}" y="${y - 14}" width="${bw.toFixed(0)}" height="27" fill="var(--sheet)" stroke="${tone}" stroke-width="1.4"/>
          <text x="${(bx + 24).toFixed(1)}" y="${y + 4}" class="tree-title">${escapeHtml(label)}</text>
          <text x="${(bx + 24).toFixed(1)}" y="${y + 27}" class="tree-meta">${escapeHtml(meta)}</text>
        </g>`;
      }).join("");
      const rootLabel = `${node.title || detail.subject_key}`;
      return `<div class="treewrap"><svg viewBox="0 0 ${W} ${H}" class="time-tree-svg" role="img" aria-label="time tree">
        ${ticks.join("")}
        <line x1="${L}" y1="${spineY}" x2="${W - R}" y2="${spineY}" stroke="var(--ink)" stroke-width="2"/>
        <text x="${L}" y="${spineY - 14}" class="tree-root">${escapeHtml(rootLabel)} <tspan class="tree-meta">${escapeHtml(compactValue(node.status) || "open")}</tspan></text>
        ${bleed}${diamonds}${kids}
      </svg></div>`;
    }

    function timeTreeHtml(detail) {
      const graph = detail.graph || {};
      const node = graph.node || {};
      const parent = (graph.parent_chain || [])[0];
      const parentHtml = parent
        ? `<button type="button" class="tree-link" data-tree-scope="${escapeHtml(detail.scope_id)}" data-tree-subject="${escapeHtml(parent.subject_key)}">${escapeHtml(parent.title)}</button>`
        : '<span class="empty">Root matter</span>';
      const treeSvg = timeTreeSvg(detail);
      const childItems = (graph.children || []).map((child) =>
        `<li class="time-tree-node"><span class="stamp">${escapeHtml(compactValue(child.status))}</span><button type="button" class="tree-link" data-tree-scope="${escapeHtml(detail.scope_id)}" data-tree-subject="${escapeHtml(child.subject_key)}">${escapeHtml(child.title)}</button><time>${escapeHtml(compactTime(child.birth_instant))}</time></li>`
      ).join("");
      const children = treeSvg
        || (childItems ? `<ul class="time-tree-list">${childItems}</ul>` : '<p class="empty">独立事项,暂无子目标。</p>');
      const decisions = (node.decisions || []).map((decision) =>
        `<li>${escapeHtml(displayValue(decision))}</li>`
      ).join("") || '<li class="empty">No decisions recorded.</li>';
      const targets = new Map();
      state.matters.filter((matter) => matter.scope_id === detail.scope_id).forEach((matter) => targets.set(matter.subject_key, matter));
      flattenTree(graph.tree).forEach((matter) => targets.set(matter.subject_key, matter));
      targets.delete(detail.subject_key);
      const targetOptions = [...targets.values()].sort((left, right) => bytewise(left.subject_key, right.subject_key)).map((matter) =>
        `<option value="${escapeHtml(matter.subject_key)}">${escapeHtml(matter.title)} · ${escapeHtml(matter.subject_key)}</option>`
      ).join("");
      const sender = escapeHtml(localStorage.getItem("matterhorn.console.sender") || "");
      const reparent = targetOptions
        ? `<form class="form-stack" id="reparent-form"><h4>Re-parent</h4><label>Parent<select id="reparent-target" required>${targetOptions}</select></label><label>Reason<textarea id="reparent-reason" required></textarea></label><label>Your name<input id="reparent-sender" required value="${sender}"></label><div id="reparent-error"></div><button class="button" type="submit">Set part_of</button></form>`
        : '<div><h4>Re-parent</h4><p class="empty">No other matter is available.</p></div>';
      const decision = `<form class="form-stack" id="decision-form"><h4>Add decision</h4><label>Decision<textarea id="decision-value" required></textarea></label><label>Your name<input id="decision-sender" required value="${sender}"></label><div id="decision-error"></div><button class="button" type="submit">Record decision</button></form>`;
      return `<section class="time-tree"><h3>Time tree</h3><p><strong>Parent</strong> · ${parentHtml}</p><ul class="time-tree-list">${children}</ul><h4>Decisions</h4><ul>${decisions}</ul><div class="structure-controls">${reparent}${decision}</div></section>`;
    }

    function detailHtml(detail) {
      const personNames = detail.person_names || {};
      const withNames = (value) => Array.isArray(value)
        ? value.map((item) => personNames[item] || item)
        : (personNames[value] || value);
      // SET predicates (participated_by, blocked_by, ...) project one current
      // value per member; render them as ONE appended row instead of a row
      // per person. Collapsed rows drop the per-value correct button.
      const grouped = [];
      for (const value of detail.current) {
        const last = grouped[grouped.length - 1];
        if (last && last.predicate === value.predicate) {
          last.items.push(value);
        } else {
          grouped.push({ predicate: value.predicate, items: [value] });
        }
      }
      const values = grouped.length
        ? grouped.map((group) => {
            if (group.items.length > 1) {
              const joined = group.items
                .map((value) => displayValue(withNames(value.value)))
                .join(" · ");
              const sourceIds = [...new Set(group.items.flatMap((value) => value.source_ids || []))];
              return `<li>
            <span class="predicate">${escapeHtml(group.predicate)}</span>
            <span>${escapeHtml(joined)}<div class="evidence">${escapeHtml(group.items[0].origin)} · ${escapeHtml(group.items[0].evidence_status)} · ${escapeHtml(sourceIds.join(", "))}</div></span>
            <span></span>
          </li>`;
            }
            const value = group.items[0];
            return `<li>
            <span class="predicate">${escapeHtml(value.predicate)}</span>
            <span>${escapeHtml(displayValue(withNames(value.value)))}<div class="evidence">${escapeHtml(value.origin)} · ${escapeHtml(value.evidence_status)} · ${escapeHtml((value.source_ids || []).join(", "))}</div></span>
            <button type="button" class="correct-value" data-predicate="${escapeHtml(value.predicate)}" data-value="${escapeHtml(JSON.stringify(value.value))}">correct</button>
          </li>`;
          }).join("")
        : '<li class="empty">No current values.</li>';
      const aliases = detail.aliases?.length
        ? `<p class="detail-aliases"><strong>又名</strong> · ${escapeHtml(detail.aliases.join(" · "))}</p>`
        : "";
      const handles = detail.handles?.length
        ? `<div class="detail-handles" aria-label="Matter handles">${detail.handles.map((handle) =>
            `<span class="handle-chip" title="${escapeHtml(handle.handle_type)}">${escapeHtml(handle.handle_value)}</span>`
          ).join("")}</div>`
        : "";
      const timeline = timelineHtml(detail, personNames);
      const timeTree = detail.subject_type === "TOPIC" ? "" : timeTreeHtml(detail);
      const gatherGroups = (detail.gather?.members_by_scope || []).map((group) =>
        `<section class="gather-scope"><h4>${escapeHtml(group.scope_id)}</h4><div>${group.members.map((member) =>
          `<button type="button" class="gather-member-chip" data-gather-scope="${escapeHtml(member.scope_id)}" data-gather-subject="${escapeHtml(member.subject_key)}">${escapeHtml(member.title)} · ${escapeHtml(compactValue(member.status))} · ${member.rollup.descendants_completed}/${member.rollup.descendants_total + 1}</button>`
        ).join("")}</div></section>`
      ).join("");
      const gatherMembership = detail.layer >= 2
        ? `<section class="gather-panel"><h3>Gathered membership</h3><p class="project-count">${detail.gather.aggregate.completed}/${detail.gather.aggregate.total} across scopes · ${detail.gather.aggregate.blocked} blocked</p>${gatherGroups || '<p class="empty">No gathered members yet.</p>'}</section>`
        : "";
      const gatherTargets = state.layerProjects;
      const gatherControl = detail.layer < 2 && gatherTargets.length
        ? `<section class="gather-panel"><h3>Gather into project</h3><form class="form-stack" id="gather-form"><label>Layer-2 project<select id="gather-target" required>${gatherTargets.sort((left, right) => bytewise(left.scope_id, right.scope_id) || bytewise(left.subject_key, right.subject_key)).map((matter) =>
          `<option value="${escapeHtml(JSON.stringify({ scope_id: matter.scope_id, subject_key: matter.subject_key }))}">${escapeHtml(matter.title)} · ${escapeHtml(matter.scope_id)}</option>`
        ).join("")}</select></label><label>Reason<textarea id="gather-reason" required></textarea></label><label>Your name<input id="gather-sender" required value="${escapeHtml(localStorage.getItem("matterhorn.console.sender") || "")}"></label><div id="gather-error"></div><button class="button" type="submit">Gather into project</button></form></section>`
        : "";
      const related = detail.related?.length
        ? `<section class="related-panel"><h3>Related</h3><ul class="related-list">${detail.related.map((matter) =>
            `<li><button type="button" class="related-item" data-related-scope="${escapeHtml(matter.scope_id)}" data-related-subject="${escapeHtml(matter.subject_key)}"><span class="scope-chip">${escapeHtml(matter.scope_id)}</span><strong>${escapeHtml(matter.title)}</strong><span class="related-via">${escapeHtml(matter.via)}</span></button></li>`
          ).join("")}</ul></section>`
        : '<section class="related-panel"><h3>Related</h3><p class="empty">No deterministic handle or title matches.</p></section>';
      const mergeTargets = state.matters.filter((matter) =>
        matter.scope_id === detail.scope_id && matter.subject_key !== detail.subject_key
      );
      const mergeControl = mergeTargets.length
        ? `<section class="merge-panel"><h3>Merge into…</h3>
            <form class="form-stack" id="merge-form">
              <div><label for="merge-target">Canonical matter</label><select id="merge-target" required>${mergeTargets.map((matter) =>
                `<option value="${escapeHtml(matter.subject_key)}">${escapeHtml(matter.title)} · ${escapeHtml(matter.subject_key)}</option>`
              ).join("")}</select></div>
              <div><label for="merge-reason">Reason</label><textarea id="merge-reason" required></textarea></div>
              <div><label for="merge-sender">Your name</label><input id="merge-sender" required autocomplete="name" value="${escapeHtml(localStorage.getItem("matterhorn.console.sender") || "")}"></div>
              <div id="merge-error"></div>
              <div class="buttons"><button class="button danger" type="submit">Merge matter</button></div>
            </form>
          </section>`
        : '<section class="merge-panel"><h3>Merge into…</h3><p class="empty">No other matters in this scope are currently on the wall.</p></section>';
      return `<div class="detail-head"><div><p class="eyebrow">${escapeHtml(detail.scope_id)} · ${escapeHtml(detail.subject_key)}</p><h2>${escapeHtml(detail.title)}</h2></div><button type="button" class="detail-close">Close</button></div>
        ${aliases}${handles}<ul class="detail-values">${values}</ul>${gatherMembership}${gatherControl}${timeTree}${timeline}${related}${mergeControl}`;
    }

    function timelineHtml(detail, personNames = {}) {
      const tracked = detail.subject_type === "TOPIC"
        ? new Set(["viewpoint"])
        : new Set(["status", "progress", "outcome"]);
      const entries = Object.entries(detail.timeline || {})
        .filter(([predicate]) => tracked.has(predicate))
        .flatMap(([predicate, values]) => values.map((value) => ({ ...value, predicate })))
        .sort((left, right) => left.valid_from.localeCompare(right.valid_from)
          || left.predicate.localeCompare(right.predicate)
          || left.assertion_id.localeCompare(right.assertion_id));
      const convNames = detail.conversation_names || {};
      const conversationOf = (sourceId) => {
        if (!sourceId) return "";
        let rest = sourceId;
        const scopePrefix = `${detail.scope_id}:`;
        if (rest.startsWith(scopePrefix)) rest = rest.slice(scopePrefix.length);
        const cut = rest.lastIndexOf(":");
        const key = cut > 0 ? rest.slice(0, cut) : rest;
        return convNames[key] || key.split(":").map((part) =>
          /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$|^[0-9a-f]{16,}$/.test(part) ? part.slice(0, 8) + "…" : part
        ).join(":");
      };
      let previousConv = null;
      const rows = entries.length
        ? entries.map((entry) => {
            const conv = conversationOf(entry.source_details?.[0]?.source_id || (entry.source_ids || [])[0]);
            const convChip = conv
              ? `<span class="conv-chip${conv === previousConv ? " repeat" : ""}" title="${escapeHtml(conv)}">${escapeHtml(conv)}</span>`
              : "";
            previousConv = conv;
            const sources = entry.source_details?.length
              ? entry.source_details.map((source) => {
                  const excerpt = (source.excerpt || "No excerpt available.").slice(0, 2000);
                  return `<div class="timeline-source"><strong>${escapeHtml(source.sender)}</strong> · <span class="clamp">${escapeHtml(excerpt)}</span></div>`;
                }).join("")
              : `<div class="timeline-source">${escapeHtml((entry.source_ids || []).join(", "))}</div>`;
            const date = new Date(entry.valid_from);
            const two = (n) => String(n).padStart(2, "0");
            const label = Number.isNaN(date.valueOf()) ? entry.valid_from : `${date.getMonth() + 1}/${date.getDate()} ${two(date.getHours())}:${two(date.getMinutes())}:${two(date.getSeconds())}`;
            return `<li class="timeline-entry"><time class="timeline-date" datetime="${escapeHtml(entry.valid_from)}">${escapeHtml(label)}</time><div><span class="predicate">${escapeHtml(entry.predicate)}</span>${convChip}<div class="timeline-value clamp clamp-value">${escapeHtml(displayValue(personNames[entry.value] || entry.value))}</div>${sources}</div></li>`;
          }).join("")
        : '<li class="empty">No timeline history yet.</li>';
      return `<section class="timeline-panel"><h3>Timeline</h3><ol class="matter-timeline">${rows}</ol></section>`;
    }

    function matterIsActive(matter, now = Date.now()) {
      const updated = Date.parse(matter.updated_at || "");
      return ACTIVE_STATUSES.has(String(matter.status ?? ""))
        || (Number.isFinite(updated) && updated >= now - (7 * 24 * 60 * 60 * 1000) && updated <= now)
        || matter.next_step != null
        || matter.due != null;
    }

    function matterSort(left, right) {
      const leftUpdated = Date.parse(left.updated_at || "");
      const rightUpdated = Date.parse(right.updated_at || "");
      const leftHasDate = Number.isFinite(leftUpdated);
      const rightHasDate = Number.isFinite(rightUpdated);
      if (leftHasDate !== rightHasDate) return leftHasDate ? -1 : 1;
      if (leftHasDate && leftUpdated !== rightUpdated) return rightUpdated - leftUpdated;
      return bytewise(left.subject_key, right.subject_key) || bytewise(left.scope_id, right.scope_id);
    }

    function compactTime(value) {
      const instant = new Date(value || "");
      if (Number.isNaN(instant.valueOf())) return "—";
      const two = (number) => String(number).padStart(2, "0");
      return `${instant.getMonth() + 1}/${instant.getDate()} ${two(instant.getHours())}:${two(instant.getMinutes())}`;
    }

    function miniTreeSvg(matter) {
      const kids = (matter.children_preview || []).slice().sort((left, right) =>
        new Date(left.birth_instant || 0) - new Date(right.birth_instant || 0));
      if (!kids.length) return "";
      const times = kids.map((kid) => new Date(kid.birth_instant || matter.updated_at || 0).valueOf());
      const min = Math.min(...times), span = Math.max(Math.max(...times) - min, 1);
      const W = 240, x0 = 8, x1 = W - 8;
      let last = -Infinity;
      const dots = kids.map((kid, index) => {
        let cx = kids.length === 1 ? (x0 + x1) / 2 : x0 + (times[index] - min) / span * (x1 - x0);
        cx = Math.min(Math.max(cx, last + 9), x1);
        last = cx;
        return `<circle cx="${cx.toFixed(1)}" cy="8" r="4" fill="${statusTone(kid.status)}"><title>${escapeHtml(kid.title)} · ${escapeHtml(compactValue(kid.status) || "open")}</title></circle>`;
      }).join("");
      return `<svg class="mini-tree" viewBox="0 0 ${W} 16" aria-hidden="true"><line x1="2" y1="8" x2="${W - 2}" y2="8"/>${dots}</svg>`;
    }

    function matterRowHtml(matter, archived = false) {
      const key = `${matter.scope_id}:${matter.subject_key}`;
      const dueDate = matter.due ? new Date(matter.due) : null;
      const validDue = dueDate && !Number.isNaN(dueDate.valueOf());
      const overdue = validDue && dueDate < new Date();
      const status = compactValue(matter.status);
      const updated = isMatterUpdated(matter)
        ? '<span class="stamp updated">updated</span>' : "";
      const blockers = (matter.blocked_by || []).map(compactValue).join(", ");
      const bubbledBlockers = (matter.bubbled_blockers || []).map((item) =>
        `${item.subject_key}: ${compactValue(item.blocker)}`
      ).join(" · ");
      const expandKey = `${matter.scope_id}:${matter.subject_key}`;
      const expanded = state.expandedRoots.has(expandKey);
      const rollup = matter.descendants_total
        ? `<span class="expand-toggle scope-chip" data-expand-root="${escapeHtml(expandKey)}" role="button" aria-expanded="${String(expanded)}">${expanded ? "▾" : "▸"} ${matter.descendants_completed}/${matter.descendants_total} 子目标</span>` : "";
      const miniTree = miniTreeSvg(matter);
      const childRows = expanded && (matter.children_preview || []).length
        ? `<div class="child-rows">${(matter.children_preview || []).slice().sort((left, right) =>
            new Date(left.birth_instant || 0) - new Date(right.birth_instant || 0)).map((kid) =>
            `<button type="button" class="child-row" data-subject="${escapeHtml(kid.subject_key)}" data-scope="${escapeHtml(matter.scope_id)}">
              <span class="child-elbow">└</span>
              <span class="stamp ${String(compactValue(kid.status) || "").toLowerCase() === "blocked" ? "blocked" : ""}">${escapeHtml(compactValue(kid.status) || "open")}</span>
              <strong>${escapeHtml(kid.title)}</strong>
              <time>${escapeHtml(compactTime(kid.birth_instant))}</time>
            </button>`).join("")}</div>` : "";
      const sources = matter.sources_display || [];
      const sourceChips = sources.slice(0, 2).map((source) =>
        `<span class="conv-chip" title="${escapeHtml(source)}">${escapeHtml(source)}</span>`
      ).join("");
      const extraSources = sources.length > 2 ? `<span class="scope-chip">+${sources.length - 2}</span>` : "";
      const ownerItems = matter.owners_display?.length
        ? matter.owners_display : (matter.owners || []);
      const owners = ownerItems.length ? compactValue(ownerItems) : null;
      return `<button type="button" class="matter-row ${archived ? "archived" : ""} ${state.selected === key ? "active" : ""}"
          data-subject="${escapeHtml(matter.subject_key)}" data-scope="${escapeHtml(matter.scope_id)}">
        <span class="stamp-group">${updated}<span class="stamp ${status === "blocked" ? "blocked" : ""}">${escapeHtml(status)}</span>${rollup}</span>
        <span class="matter-row-title"><span class="scope-chip">${escapeHtml(matter.scope_id)}</span><strong>${escapeHtml(matter.title)}</strong>${miniTree}</span>
        <span class="matter-row-summary"><span class="row-label">Summary</span>${escapeHtml(matter.progress || "—")}</span>
        <span class="matter-row-blocker">${blockers || bubbledBlockers ? `<span class="row-label">Problem</span>${blockers ? `blocked: ${escapeHtml(blockers)}` : ""}${blockers && bubbledBlockers ? " · " : ""}${bubbledBlockers ? `子目标: ${escapeHtml(bubbledBlockers)}` : ""}` : ""}</span>
        <span class="matter-row-meta">${sourceChips}${extraSources}${owners ? `<span title="Owners">${escapeHtml(owners)}</span>` : ""}<span class="${overdue ? "overdue" : ""}" title="Due">due ${escapeHtml(validDue ? compactTime(matter.due) : "—")}</span>${matter.next_step != null ? `<span class="next-chip" title="${escapeHtml(compactValue(matter.next_step))}">next ${escapeHtml(compactValue(matter.next_step))}</span>` : ""}<time datetime="${escapeHtml(matter.updated_at || "")}" title="Updated">${escapeHtml(compactTime(matter.updated_at))}</time></span>
      </button>${childRows}`;
    }

    function projectKey(matter) {
      return `${matter.scope_id}:${matter.subject_key}`;
    }

    function isProject(matter) {
      return matter.layer >= 2 || (matter.descendants_total || 0) > 0 || state.pinnedProjects.has(projectKey(matter));
    }

    function projectSort(left, right) {
      const blockedDelta = (right.bubbled_blockers?.length || 0) - (left.bubbled_blockers?.length || 0);
      if (blockedDelta) return blockedDelta;
      const unseenDelta = Number(Boolean(right.unseen)) - Number(Boolean(left.unseen));
      if (unseenDelta) return unseenDelta;
      return new Date(right.latest_activity || right.updated_at || 0) - new Date(left.latest_activity || left.updated_at || 0);
    }

    function projectCardHtml(matter) {
      const key = projectKey(matter);
      const expanded = state.expandedRoots.has(key);
      const status = compactValue(matter.status) || "open";
      const federated = matter.layer >= 2;
      const total = federated ? (matter.gather_total || 0) : (matter.descendants_total || 0);
      const completed = federated ? (matter.gather_completed || 0) : matter.descendants_completed;
      const doneShare = total ? (completed / total) * 100 : 0;
      const blockers = (federated ? (matter.gather_bubbled_blockers || []) : (matter.bubbled_blockers || [])).map((item) =>
        `${item.reference || item.subject_key}: ${compactValue(item.blocker)}`).join(" · ");
      const gatherChips = federated ? (matter.gather_members_by_scope || []).map((group) =>
        `<div class="gather-scope"><span class="gather-scope-label">${escapeHtml(group.scope_id)}</span>${group.members.map((member) =>
          `<button type="button" class="gather-member-chip" data-subject="${escapeHtml(member.subject_key)}" data-scope="${escapeHtml(member.scope_id)}">${escapeHtml(member.title)}</button>`
        ).join("")}</div>`
      ).join("") : "";
      const kids = expanded ? (matter.children_preview || []).slice().sort((left, right) =>
        new Date(left.birth_instant || 0) - new Date(right.birth_instant || 0)).map((kid) =>
        `<button type="button" class="child-row" data-subject="${escapeHtml(kid.subject_key)}" data-scope="${escapeHtml(matter.scope_id)}">
          <span class="child-elbow">└</span>
          <span class="stamp ${String(compactValue(kid.status) || "").toLowerCase() === "blocked" ? "blocked" : ""}">${escapeHtml(compactValue(kid.status) || "open")}</span>
          <strong>${escapeHtml(kid.title)}</strong>
          <time>${escapeHtml(compactTime(kid.birth_instant))}</time>
        </button>`).join("") : "";
      return `<article class="project-card ${expanded ? "expanded" : ""} ${matter.unseen ? "unseen" : ""}" data-expand-root="${escapeHtml(key)}">
        <header>
          <span class="stamp ${status === "blocked" ? "blocked" : ""}">${escapeHtml(status)}</span>
          <span class="scope-chip">${escapeHtml(matter.scope_id)}</span>
          <button type="button" class="pin-toggle ${state.pinnedProjects.has(key) ? "pinned" : ""}" data-pin="${escapeHtml(key)}" title="置顶/取消置顶">${state.pinnedProjects.has(key) ? "★" : "☆"}</button>
        </header>
        <h3 class="project-title" data-subject="${escapeHtml(matter.subject_key)}" data-scope="${escapeHtml(matter.scope_id)}">${escapeHtml(matter.title)}</h3>
        ${total ? `<div class="project-progress"><span style="width:${doneShare.toFixed(0)}%"></span></div>
        <p class="project-count">${completed}/${total} ${federated ? "across scopes" : `子目标 ${expanded ? "▾" : "▸ 点击展开"}`}</p>` : `<p class="project-count">${federated ? "0/0 across scopes" : "独立事项 · 置顶项目"}</p>`}
        ${gatherChips}
        ${miniTreeSvg(matter)}
        ${blockers ? `<p class="project-blockers">⛔ ${escapeHtml(blockers)}</p>` : ""}
        ${matter.next_step != null ? `<p class="project-next">next · ${escapeHtml(compactValue(matter.next_step))}</p>` : ""}
        <footer><time>${escapeHtml(compactTime((federated ? matter.gather_latest_activity : matter.latest_activity) || matter.updated_at))}</time></footer>
        ${kids ? `<div class="child-rows">${kids}</div>` : ""}
      </article>`;
    }

    function renderMatters() {
      const now = Date.now();
      const grouped = new Map(groupOrder(state.matters).map((group) => [group, []]));
      state.matters.forEach((matter) => {
        const group = groupForScope(matter.scope_id);
        if (!grouped.has(group)) grouped.set(group, []);
        grouped.get(group).push(matter);
      });
      const projects = state.matters.filter((matter) => isProject(matter) && matterIsActive(matter, now)).sort(projectSort);
      const projectSection = `<section class="sheet project-deck"><header class="deck-header"><strong>核心项目</strong><span>${projects.length} 个 · 其余事项收在下方抽屉</span></header>
        <div class="project-grid">${projects.map(projectCardHtml).join("") || '<p class="empty" style="padding:.6rem .85rem">还没有项目——给任一事项挂上子目标,或用 ☆ 把它置顶成项目。</p>'}</div></section>`;
      const sections = [...grouped.entries()].map(([group, matters]) => {
        const active = matters.filter((matter) => matterIsActive(matter, now)).sort(matterSort);
        const archived = matters.filter((matter) => !matterIsActive(matter, now)).sort(matterSort);
        const collapsed = state.collapsedGroups.has(group);
        const archiveOpen = !state.focusMode || state.openArchives.has(group);
        const archive = archived.length
          ? `<details class="archive-drawer" data-archive="${escapeHtml(group)}" ${archiveOpen ? "open" : ""}><summary>Archive (${archived.length})</summary><div class="matter-rows">${archived.map((matter) => matterRowHtml(matter, true)).join("")}</div></details>`
          : "";
        return `<section class="sheet matter-group ${collapsed ? "collapsed" : ""}" data-group="${escapeHtml(group)}">
          <button type="button" class="matter-group-header" data-group-toggle="${escapeHtml(group)}" aria-expanded="${String(!collapsed)}"><strong>${escapeHtml(group)}</strong><span>active ${active.length} · archived ${archived.length}</span></button>
          <div class="matter-group-body"><div class="matter-rows">${active.map((matter) => matterRowHtml(matter)).join("") || '<p class="empty" style="padding:.6rem .85rem">No active matters.</p>'}</div>${archive}</div>
        </section>`;
      }).join("");
      const othersCount = state.matters.filter((matter) => !isProject(matter)).length;
      const othersOpen = state.othersOpen ? "open" : "";
      byId("matter-list").innerHTML = projectSection +
        `<details class="others-drawer" id="others-drawer" ${othersOpen}><summary>其他事项(${othersCount})· 按组浏览</summary>${sections || '<p class="empty">No matters match this scope filter.</p>'}</details>`;
      const activeCount = state.matters.filter((matter) => matterIsActive(matter, now)).length;
      byId("top-summary").textContent = `${activeCount} active · ${state.matters.length - activeCount} archived · ${state.scopes.length} scope${state.scopes.length === 1 ? "" : "s"}`;
      renderToday();
    }

    async function loadDetail(scope, subject) {
      const matter = state.matters.find((item) => item.scope_id === scope && item.subject_key === subject);
      state.detail = await api(`/v1/scopes/${encodeURIComponent(scope)}/matters/${encodeURIComponent(subject)}`);
      state.detail.scope_id = scope;
      state.selected = `${scope}:${subject}`;
      setWorkingScope(scope);
      byId("query-subject").value = subject;
      markMatterSeen(matter);
      await api(`/v1/matters/${encodeURIComponent(subject)}/seen`, {
        method: "POST", body: JSON.stringify({ scope_id: scope })
      }).catch(() => { /* Detail remains available if seen persistence fails. */ });
      if (matter) matter.unseen = false;
      renderMatters();
      byId("detail-dialog-body").innerHTML = detailHtml(state.detail);
      const dialog = byId("detail-dialog");
      if (!dialog.open) dialog.showModal();
    }

    function openCorrection(button) {
      const value = JSON.parse(button.dataset.value);
      byId("correction-target").textContent = `${state.detail.scope_id} · ${state.detail.title} · ${button.dataset.predicate}`;
      byId("correction-value").value = typeof value === "string" ? value : jsonText(value);
      byId("correction-reason").value = "";
      byId("correction-sender").value = localStorage.getItem("matterhorn.console.sender") || "";
      byId("correction-form").dataset.predicate = button.dataset.predicate;
      byId("correction-error").innerHTML = "";
      byId("correction-dialog").showModal();
    }

    async function submitCorrection(event) {
      event.preventDefault();
      let value = byId("correction-value").value.trim();
      try { value = JSON.parse(value); } catch (_) { /* Preserve intentional text. */ }
      const sender = byId("correction-sender").value.trim();
      const reason = byId("correction-reason").value.trim();
      const now = new Date().toISOString();
      localStorage.setItem("matterhorn.console.sender", sender);
      try {
        await api(`/v1/scopes/${encodeURIComponent(state.detail.scope_id)}/corrections`, {
          method: "POST",
          body: JSON.stringify({
            subject_key: state.detail.subject_key,
            subject_type: state.detail.subject_type,
            predicate: byId("correction-form").dataset.predicate,
            object_value: value,
            valid_from: now,
            source_refs: [{ source_id: `console:${crypto.randomUUID()}`, sent_at: now, sender, excerpt: `Console correction. Reason: ${reason}` }]
          })
        });
        byId("correction-dialog").close();
        await loadDetail(state.detail.scope_id, state.detail.subject_key);
        await loadMatters();
        byId("detail-dialog-body").innerHTML = detailHtml(state.detail);
      } catch (error) {
        byId("correction-error").innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
      }
    }

    async function submitStructureCorrection({ predicate, value, reason, sender, errorId }) {
      const now = new Date().toISOString();
      localStorage.setItem("matterhorn.console.sender", sender);
      try {
        await api(`/v1/scopes/${encodeURIComponent(state.detail.scope_id)}/corrections`, {
          method: "POST",
          body: JSON.stringify({
            subject_key: state.detail.subject_key,
            subject_type: state.detail.subject_type,
            predicate,
            object_value: value,
            valid_from: now,
            source_refs: [{ source_id: `console:${crypto.randomUUID()}`, sent_at: now, sender, excerpt: reason }]
          })
        });
        await Promise.all([
          loadDetail(state.detail.scope_id, state.detail.subject_key),
          loadMatters()
        ]);
      } catch (error) {
        byId(errorId).innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
      }
    }

    function submitReparent(event) {
      event.preventDefault();
      return submitStructureCorrection({
        predicate: "part_of",
        value: byId("reparent-target").value,
        reason: `Console re-parent. Reason: ${byId("reparent-reason").value.trim()}`,
        sender: byId("reparent-sender").value.trim(),
        errorId: "reparent-error"
      });
    }

    function submitDecision(event) {
      event.preventDefault();
      return submitStructureCorrection({
        predicate: "decision",
        value: byId("decision-value").value.trim(),
        reason: "Console decision entry.",
        sender: byId("decision-sender").value.trim(),
        errorId: "decision-error"
      });
    }

    async function submitGather(event) {
      event.preventDefault();
      const target = JSON.parse(byId("gather-target").value);
      const sender = byId("gather-sender").value.trim();
      const reason = byId("gather-reason").value.trim();
      const now = new Date().toISOString();
      localStorage.setItem("matterhorn.console.sender", sender);
      try {
        await api(`/v1/scopes/${encodeURIComponent(target.scope_id)}/corrections`, {
          method: "POST",
          body: JSON.stringify({
            subject_key: target.subject_key,
            subject_type: "MATTER",
            predicate: "gathers",
            object_value: gatherSubjectRef(state.detail.scope_id, state.detail.subject_key),
            valid_from: now,
            source_refs: [{
              source_id: `console:${crypto.randomUUID()}`,
              sent_at: now,
              sender,
              excerpt: `Console gather into project. Reason: ${reason}`
            }]
          })
        });
        await Promise.all([
          loadDetail(state.detail.scope_id, state.detail.subject_key),
          loadMatters()
        ]);
      } catch (error) {
        byId("gather-error").innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
      }
    }

    async function submitMerge(event) {
      event.preventDefault();
      const sender = byId("merge-sender").value.trim();
      const reason = byId("merge-reason").value.trim();
      const target = byId("merge-target").value;
      const now = new Date().toISOString();
      localStorage.setItem("matterhorn.console.sender", sender);
      try {
        await api(`/v1/scopes/${encodeURIComponent(state.detail.scope_id)}/merges`, {
          method: "POST",
          body: JSON.stringify({
            source_subject_key: state.detail.subject_key,
            target_subject_key: target,
            source_refs: [{
              source_id: `console:${crypto.randomUUID()}`,
              sent_at: now,
              sender,
              excerpt: `Console subject merge. Reason: ${reason}`
            }]
          })
        });
        byId("detail-dialog").close();
        state.detail = null;
        state.selected = "";
        await Promise.all([loadMatters(), loadActivity()]);
      } catch (error) {
        byId("merge-error").innerHTML = `<div class="error-box">${escapeHtml(error.message)}</div>`;
      }
    }

    function applyMailPreset() {
      const preset = mailPresets[byId("mail-provider").value];
      if (!preset) return;
      byId("mail-host").value = preset.host;
      byId("mail-port").value = preset.port;
      byId("mail-ssl").checked = preset.ssl;
    }

    async function loadMailAccounts() {
      state.mailAccounts = await api("/v1/connectors/mail/accounts");
      renderMailAccounts();
    }

    function renderMailAccounts() {
      byId("mail-stamp").textContent = `${state.mailAccounts.length} account${state.mailAccounts.length === 1 ? "" : "s"}`;
      byId("mail-account-list").innerHTML = state.mailAccounts.length
        ? state.mailAccounts.map((status) => {
            const config = status.config;
            return `<li class="account-row">
              <div class="account-title"><strong>${escapeHtml(config.account)}</strong><span class="account-provider">${escapeHtml(config.provider)}</span></div>
              <dl class="account-meta">
                <dt>id</dt><dd>${escapeHtml(config.account_id)}</dd>
                <dt>folder</dt><dd>${escapeHtml(config.folder)} → ${escapeHtml(status.scope_id || "scope required")}</dd>
                <dt>watermark</dt><dd>${escapeHtml(status.uid_watermark ?? "—")}</dd>
                <dt>next run</dt><dd>${escapeHtml(status.next_run_at ? new Date(status.next_run_at).toLocaleString() : "off")}</dd>
                <dt>password</dt><dd>${escapeHtml(status.password_state)}</dd>
              </dl>
              <div class="account-actions">
                <button class="button" data-mail-action="sync" data-account-id="${escapeHtml(config.account_id)}">Sync now</button>
                <button class="button secondary" data-mail-action="reset" data-account-id="${escapeHtml(config.account_id)}">Re-pull recent</button>
                <button class="button danger" data-mail-action="delete" data-account-id="${escapeHtml(config.account_id)}">Remove</button>
              </div>
              ${status.error ? `<div class="status-line error">${escapeHtml(status.error)}</div>` : ""}
            </li>`;
          }).join("")
        : '<li class="empty">No mailboxes configured.</li>';
    }

    async function saveMailConfig(event) {
      event.preventDefault();
      const password = byId("mail-password").value;
      try {
        await api("/v1/connectors/mail/accounts", {
          method: "POST",
          body: JSON.stringify({
            ...(byId("mail-name").value.trim() ? { account_id: byId("mail-name").value.trim() } : {}),
            provider: byId("mail-provider").value,
            host: byId("mail-host").value.trim(),
            port: Number(byId("mail-port").value),
            ssl: byId("mail-ssl").checked,
            account: byId("mail-account").value.trim(),
            folder: byId("mail-folder").value.trim(),
            interval: byId("mail-interval").value,
            initial_window: Number(byId("mail-initial-window").value),
            scope: byId("mail-scope").value.trim(),
            ...(password ? { password } : {})
          })
        });
        byId("mail-password").value = "";
        byId("mail-config-form").reset();
        applyMailPreset();
        await loadMailAccounts();
        setStatus("mail-message", "Mailbox added. Its credential exists only in this server process.", "success");
      } catch (error) {
        byId("mail-password").value = "";
        setStatus("mail-message", error.message, "error");
      }
    }

    async function mailAction(accountId, action) {
      const status = state.mailAccounts.find((item) => item.config.account_id === accountId);
      try {
        if (action === "delete") {
          if (!window.confirm(`Remove ${accountId}? Its stored watermark will be retained.`)) return;
          const result = await api(accountPath(accountId), { method: "DELETE" });
          setStatus("mail-message", result.message, "success");
        } else if (action === "reset") {
          if (!window.confirm(`Re-pull recent messages for ${accountId}?`)) return;
          await api(accountPath(accountId, "/reset"), {
            method: "POST", body: JSON.stringify({ scope_id: status.scope_id, confirm: true })
          });
          setStatus("mail-message", "Saved position cleared; next sync uses the first-pull window.", "success");
        } else {
          setStatus("mail-message", `Syncing ${accountId}…`);
          const report = await api(accountPath(accountId, "/sync"), {
            method: "POST", body: JSON.stringify({ scope_id: status.scope_id })
          });
          setStatus("mail-message", `Pulled ${report.pulled}; produced ${report.cards_produced} cards and ${report.new_assertions} assertions.`, "success");
          await loadScopes(report.scope_id);
          await loadMatters();
        }
        await loadMailAccounts();
        await loadConnections();
      } catch (error) {
        setStatus("mail-message", error.message, "error");
        await loadMailAccounts().catch(() => {});
      }
    }

    function aiPayload() {
      const key = byId("ai-key").value;
      return {
        provider: byId("ai-provider").value,
        base_url: byId("ai-base-url").value.trim(),
        model: byId("ai-model").value.trim(),
        timeout: Number(byId("ai-timeout").value),
        ...(key ? { api_key: key } : {})
      };
    }

    async function loadAIStatus() {
      state.ai = await api("/v1/connectors/ai/status");
      if (state.ai.config) {
        byId("ai-provider").value = state.ai.config.provider;
        byId("ai-base-url").value = state.ai.config.base_url;
        byId("ai-model").value = state.ai.config.model;
        byId("ai-timeout").value = state.ai.config.timeout;
      }
      renderAIStatus();
    }

    function renderAIStatus() {
      const ai = state.ai || {};
      setStatus("ai-status", ai.configured
        ? `${ai.config.provider} · ${ai.config.model} · ${ai.api_key_state} · ${ai.source || "runtime"}`
        : "Not configured. Extraction and chat require an AI key unless a fixture gateway is active.",
        ai.chat_enabled ? "success" : "");
      byId("chat-panel").hidden = !ai.chat_enabled;
      if (ai.chat_enabled) byId("chat-provider").textContent = ai.config.provider;
    }

    async function saveAI(event) {
      event.preventDefault();
      try {
        state.ai = await api("/v1/connectors/ai/config", { method: "POST", body: JSON.stringify(aiPayload()) });
        byId("ai-key").value = "";
        renderAIStatus();
        setStatus("ai-status", `${state.ai.config.provider} · ${state.ai.config.model} · ${state.ai.api_key_state}`, "success");
        await loadConnections();
      } catch (error) {
        byId("ai-key").value = "";
        setStatus("ai-status", error.message, "error");
      }
    }

    async function testAI() {
      try {
        const result = await api("/v1/connectors/ai/test", { method: "POST", body: JSON.stringify(aiPayload()) });
        setStatus("ai-status", result.message, result.reachable ? "success" : "error");
      } catch (error) {
        setStatus("ai-status", error.message, "error");
      }
    }

    async function extractFeed() {
      const scope = byId("feed-scope").value.trim();
      setStatus("feed-status", "Extracting and flushing…");
      byId("feed-receipt").hidden = true;
      try {
        const receipt = await api(`/v1/scopes/${encodeURIComponent(scope)}/ingest`, {
          method: "POST", body: JSON.stringify({ text: byId("feed-text").value, wait: true })
        });
        setStatus("feed-status", `Detected ${receipt.input_format}; ${receipt.status}. Gate accepted ${receipt.gate?.accepted ?? 0}.`, "success");
        byId("feed-receipt").textContent = jsonText(receipt);
        byId("feed-receipt").hidden = false;
        await loadScopes(scope);
        await loadMatters();
      } catch (error) {
        setStatus("feed-status", error.message, "error");
      }
    }

    async function uploadFeed() {
      const scope = byId("feed-scope").value.trim();
      const file = byId("feed-file").files[0];
      if (!file) return setStatus("feed-status", "Choose a .mbox, .eml, .yaml, or .json file.", "error");
      const body = new FormData();
      body.append("file", file);
      try {
        const receipt = await api(`/v1/scopes/${encodeURIComponent(scope)}/upload`, { method: "POST", body });
        setStatus("feed-status", `Uploaded ${file.name}; ${receipt.status}.`, "success");
        byId("feed-receipt").textContent = jsonText(receipt);
        byId("feed-receipt").hidden = false;
        await loadScopes(scope);
        await loadMatters();
      } catch (error) {
        setStatus("feed-status", error.message, "error");
      }
    }

    function renderToday() {
      const matterByKey = new Map(state.matters.map((matter) =>
        [`${matter.scope_id}:${matter.subject_key}`, matter]
      ));
      const today = new Date();
      const sameLocalDay = (value) => {
        const date = new Date(value);
        return !Number.isNaN(date.valueOf())
          && date.getFullYear() === today.getFullYear()
          && date.getMonth() === today.getMonth()
          && date.getDate() === today.getDate();
      };
      const byGroup = new Map();
      for (const event of state.activity) {
        if (!["progress", "status"].includes(event.predicate) || !sameLocalDay(event.recorded_at)) continue;
        const matter = matterByKey.get(`${event.scope_id}:${event.subject_key}`);
        if (!matter) continue;
        const group = groupForScope(event.scope_id);
        if (!byGroup.has(group)) byGroup.set(group, []);
        if (byGroup.get(group).length < 3) byGroup.get(group).push({ event, matter });
      }
      const entries = groupOrder(state.matters).flatMap((group) =>
        (byGroup.get(group) || []).map(({ event, matter }) =>
          `<button type="button" class="today-entry" data-scope="${escapeHtml(event.scope_id)}" data-subject="${escapeHtml(event.subject_key)}"><span class="scope-chip">${escapeHtml(group)}</span><strong>${escapeHtml(matter.title)}</strong><span>${escapeHtml(event.predicate)} · ${escapeHtml(compactValue(event.new_value))}</span></button>`
        )
      );
      byId("today-entries").innerHTML = entries.join("");
      byId("today-strip").hidden = entries.length === 0;
    }

    async function loadActivity() {
      state.activity = await api("/v1/events?limit=200");
      byId("activity-list").innerHTML = state.activity.length
        ? state.activity.map((event) => `<li class="activity-item"><strong>${escapeHtml(event.matter_title)}</strong><div>${escapeHtml(event.predicate)}: ${escapeHtml(compactValue(event.old_value))} → ${escapeHtml(compactValue(event.new_value))}</div><div class="activity-meta">${escapeHtml(event.scope_id)} · ${escapeHtml(event.origin)} · ${escapeHtml(new Date(event.recorded_at).toLocaleString())}</div></li>`).join("")
        : '<li class="empty">No projection changes yet.</li>';
      renderToday();
    }

    async function loadConnections() {
      state.connections = await api("/v1/connections");
      const ai = state.connections.ai;
      const accounts = state.connections.mail_accounts || [];
      const rows = [
        `<li class="connection-item"><strong>Mail</strong> · ${accounts.length} account${accounts.length === 1 ? "" : "s"} · ${accounts.filter((item) => item.syncing).length} syncing</li>`,
        `<li class="connection-item"><strong>AI</strong> · ${escapeHtml(ai?.configured ? `${ai.config.provider}/${ai.config.model}` : "not configured")} · ${escapeHtml(ai?.api_key_state || "re-enter API key")}</li>`,
        `<li class="connection-item"><strong>Queue</strong> · ${escapeHtml(state.connections.distill_queue_length)} pending</li>`,
        ...state.connections.scopes.map((scope) => `<li class="connection-item"><strong>${escapeHtml(scope.scope_id)}</strong> · ${escapeHtml(scope.message_count)} messages · ${escapeHtml(scope.last_ingestion_at ? new Date(scope.last_ingestion_at).toLocaleString() : "never")}</li>`)
      ];
      byId("connection-list").innerHTML = rows.join("");
    }

    async function pollHub() {
      // Overlapping cycles pile requests behind slow reads and starve the
      // browser's per-origin connection pool; skip while one is in flight.
      if (pollHub.inFlight) return;
      pollHub.inFlight = true;
      try {
        await Promise.all([loadActivity(), loadConnections(), loadMailAccounts(), pollWall(), pollRawStream(), pollAssetVersion()]);
      } finally {
        pollHub.inFlight = false;
      }
    }

    async function pollAssetVersion() {
      // First poll records the baseline; a later mismatch means the hub was
      // redeployed with UI changes — offer a reload instead of silently
      // running stale scripts against new data.
      const payload = await api("/v1/console/version");
      if (!state.assetVersion) { state.assetVersion = payload.version; return; }
      if (payload.version !== state.assetVersion) {
        byId("stale-banner").classList.add("show");
      }
    }

    async function pollWall() {
      // Keep the wall live without re-render churn: only touch the DOM on change.
      let scopes = await api("/v1/scopes");
      if (JSON.stringify(scopes) !== JSON.stringify(state.scopes)) {
        await loadScopes(state.chatScope);
        await loadConsoleConfig();
        scopes = state.scopes;
      }
      const query = state.filter === "all" ? "" : `?scope=${encodeURIComponent(state.filter)}`;
      const matters = await api(`/v1/matters${query}`);
      if (JSON.stringify(matters) !== JSON.stringify(state.matters)) {
        state.matters = matters;
        renderMatters();
      }
      const reviews = await fetchReviews(scopes);
      const reviewCount = reviews.length;
      if (reviewCount !== state.reviewCount
          || JSON.stringify(reviews) !== JSON.stringify(state.reviews)) {
        state.reviews = reviews;
        state.reviewCount = reviewCount;
        renderReviews();
      }
    }

    async function loadConsoleConfig() {
      const config = await api("/v1/console/config");
      state.groups = config.groups || {};
      state.scopeToGroup = config.scope_to_group || {};
      renderMatters();
      if (config.chat_enabled) {
        byId("chat-panel").hidden = false;
        byId("chat-provider").textContent = config.chat_provider;
      }
    }

    async function loadChatConfig() {
      await loadAIStatus();
      await loadConsoleConfig();
    }

    async function askChat(event) {
      event.preventDefault();
      const input = byId("chat-input");
      const message = input.value.trim();
      if (!message || !state.chatScope) return;
      appendChat("user", message, []);
      input.value = "";
      const history = state.chatHistory.slice(-20);
      state.chatHistory.push({ role: "user", content: message });
      try {
        const reply = await api(`/v1/scopes/${encodeURIComponent(state.chatScope)}/chat`, {
          method: "POST", body: JSON.stringify({ message, history })
        });
        appendChat("assistant", reply.answer, reply.evidence);
        state.chatHistory.push({ role: "assistant", content: reply.answer });
      } catch (error) {
        appendChat("assistant", `Chat error: ${error.message}`, []);
      }
    }

    function appendChat(role, content, evidence) {
      const item = document.createElement("li");
      item.className = `chat-message ${role}`;
      const chips = evidence?.length ? `<div class="evidence">${evidence.map((trace) =>
        `<button type="button" class="evidence-chip" data-subjects="${escapeHtml((trace.subject_keys || []).join(","))}">${trace.error ? "Error" : "Evidence"} · ${escapeHtml(trace.name)}</button>`
      ).join(" ")}</div>` : "";
      item.innerHTML = `<p>${escapeHtml(content)}</p>${chips}`;
      byId("chat-log").append(item);
      item.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function highlightSubjects(subjects) {
      const keys = new Set(subjects.split(",").filter(Boolean));
      document.querySelectorAll(".matter-row").forEach((row) => {
        row.classList.remove("flash");
        if (keys.has(row.dataset.subject)) {
          void row.offsetWidth;
          row.classList.add("flash");
          row.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    }

    function updateQueryFields() {
      const kind = byId("query-kind").value;
      const byPerson = kind === "by-person";
      byId("query-person-wrap").hidden = !byPerson;
      byId("query-subject-wrap").hidden = byPerson;
      byId("query-predicate-wrap").hidden = byPerson;
      byId("query-instant-wrap").hidden = kind !== "at";
    }

    async function runQuery(event) {
      event.preventDefault();
      if (!state.chatScope) return;
      const kind = byId("query-kind").value;
      const params = new URLSearchParams();
      if (kind === "by-person") params.set("person_id", byId("query-person").value);
      else {
        params.set("subject_key", byId("query-subject").value);
        params.set("predicate", byId("query-predicate").value);
        if (kind === "at") params.set("instant", new Date(byId("query-instant").value).toISOString());
      }
      try {
        state.queryResult = await api(`/v1/scopes/${encodeURIComponent(state.chatScope)}/query/${kind}?${params}`);
      } catch (error) {
        state.queryResult = { error: error.message };
      }
      renderQueryResult();
    }

    function renderQueryResult() {
      byId("toggle-json").disabled = false;
      byId("query-json").textContent = jsonText(state.queryResult);
      if (state.queryResult.error) {
        byId("query-human").innerHTML = `<div class="error-box">${escapeHtml(state.queryResult.error)}</div>`;
        return;
      }
      const rows = Array.isArray(state.queryResult) ? state.queryResult : [state.queryResult];
      byId("query-human").innerHTML = rows.length
        ? rows.map((row) => `<div class="result-row"><strong>${escapeHtml(row.title || row.predicate || row.subject_key || "Result")}</strong><div>${escapeHtml(displayValue(row.value ?? row.current ?? row))}</div></div>`).join("")
        : '<p class="empty">No values matched.</p>';
    }

    byId("scope-list").addEventListener("click", (event) => {
      const button = event.target.closest("[data-scope]");
      if (button) selectWallFilter(button.dataset.scope);
    });
    byId("focus-toggle").addEventListener("click", (event) => {
      const button = event.target.closest("[data-wall-mode]");
      if (button) setWallMode(button.dataset.wallMode);
    });
    byId("matter-list").addEventListener("click", (event) => {
      const groupToggle = event.target.closest("[data-group-toggle]");
      if (groupToggle) {
        const group = groupToggle.dataset.groupToggle;
        if (state.collapsedGroups.has(group)) state.collapsedGroups.delete(group);
        else state.collapsedGroups.add(group);
        try { localStorage.setItem(COLLAPSED_GROUPS_KEY, JSON.stringify([...state.collapsedGroups])); } catch (_) { /* Optional preference. */ }
        renderMatters();
        return;
      }
      const pin = event.target.closest("[data-pin]");
      if (pin) {
        event.stopPropagation();
        const key = pin.dataset.pin;
        if (state.pinnedProjects.has(key)) state.pinnedProjects.delete(key);
        else state.pinnedProjects.add(key);
        try { localStorage.setItem("matterhorn.console.pins", JSON.stringify([...state.pinnedProjects])); } catch (_) { /* Optional preference. */ }
        renderMatters();
        return;
      }
      const row = event.target.closest("[data-subject]");
      const expand = event.target.closest("[data-expand-root]");
      // Deeper element wins: a title/child inside a card opens detail; the
      // rollup toggle inside a wall row expands.
      if (row && (!expand || expand.contains(row))) {
        loadDetail(row.dataset.scope, row.dataset.subject);
        return;
      }
      if (expand) {
        const key = expand.dataset.expandRoot;
        if (state.expandedRoots.has(key)) state.expandedRoots.delete(key);
        else state.expandedRoots.add(key);
        renderMatters();
      }
    });
    byId("matter-list").addEventListener("toggle", (event) => {
      if (event.target.id === "others-drawer") {
        state.othersOpen = event.target.open;
        return;
      }
      const drawer = event.target.closest("[data-archive]");
      if (!drawer) return;
      if (drawer.open) state.openArchives.add(drawer.dataset.archive);
      else state.openArchives.delete(drawer.dataset.archive);
    }, true);
    byId("today-entries").addEventListener("click", (event) => {
      const entry = event.target.closest("[data-subject]");
      if (entry) loadDetail(entry.dataset.scope, entry.dataset.subject);
    });
    byId("review-list").addEventListener("click", (event) => {
      const button = event.target.closest("[data-review-action]");
      if (button) resolveReview(button);
    });
    byId("detail-dialog").addEventListener("click", (event) => {
      const gathered = event.target.closest("[data-gather-subject]");
      if (gathered) { loadDetail(gathered.dataset.gatherScope, gathered.dataset.gatherSubject); return; }
      const tree = event.target.closest("[data-tree-subject]");
      if (tree) { loadDetail(tree.dataset.treeScope, tree.dataset.treeSubject); return; }
      const related = event.target.closest("[data-related-subject]");
      if (related) { loadDetail(related.dataset.relatedScope, related.dataset.relatedSubject); return; }
      const correct = event.target.closest(".correct-value");
      if (correct) { openCorrection(correct); return; }
      const clamp = event.target.closest(".clamp");
      if (clamp) { clamp.classList.toggle("open"); return; }
      if (event.target.closest(".detail-close") || event.target === byId("detail-dialog")) {
        byId("detail-dialog").close();
      }
    });
    byId("detail-dialog").addEventListener("submit", (event) => {
      if (event.target.closest("#merge-form")) submitMerge(event);
      else if (event.target.closest("#gather-form")) submitGather(event);
      else if (event.target.closest("#reparent-form")) submitReparent(event);
      else if (event.target.closest("#decision-form")) submitDecision(event);
    });
    byId("mail-account-list").addEventListener("click", (event) => {
      const button = event.target.closest("[data-mail-action]");
      if (button) mailAction(button.dataset.accountId, button.dataset.mailAction);
    });
    byId("chat-log").addEventListener("click", (event) => {
      const chip = event.target.closest(".evidence-chip");
      if (chip) highlightSubjects(chip.dataset.subjects);
    });
    byId("chat-scope").addEventListener("change", (event) => { state.chatScope = event.target.value; });
    byId("mail-provider").addEventListener("change", applyMailPreset);
    byId("ai-provider").addEventListener("change", () => {
      if (byId("ai-provider").value === "anthropic" && byId("ai-base-url").value.includes("openai")) {
        byId("ai-base-url").value = "https://api.anthropic.com";
      }
    });
    byId("mail-config-form").addEventListener("submit", saveMailConfig);
    byId("ai-form").addEventListener("submit", saveAI);
    byId("ai-test").addEventListener("click", testAI);
    byId("extract-feed").addEventListener("click", extractFeed);
    byId("upload-feed").addEventListener("click", uploadFeed);
    byId("load-sample").addEventListener("click", () => {
      byId("feed-scope").value = "personal";
      byId("feed-text").value = [
        "Dana Reyes: I own the octo-org personal Console launch and it is in progress.",
        "Dana Reyes: The unified matter wall is connected.",
        "Dana Reyes: The next step is to review the evidence cards by August 5."
      ].join("\n");
      setStatus("feed-status", "Fictional Dana Reyes / octo-org sample loaded.");
    });
    byId("refresh-matters").addEventListener("click", loadMatters);
    byId("stale-banner").addEventListener("click", () => window.location.reload());
    byId("correction-form").addEventListener("submit", submitCorrection);
    byId("cancel-correction").addEventListener("click", () => byId("correction-dialog").close());
    byId("chat-form").addEventListener("submit", askChat);
    byId("query-kind").addEventListener("change", updateQueryFields);
    byId("query-form").addEventListener("submit", runQuery);
    byId("toggle-json").addEventListener("click", () => {
      byId("query-json").hidden = !byId("query-json").hidden;
      byId("query-human").hidden = !byId("query-json").hidden;
    });

    restoreWallPreferences();
    byId("correction-sender").value = localStorage.getItem("matterhorn.console.sender") || "";
    updateQueryFields();
    applyMailPreset();
    Promise.all([loadScopes().then(() => loadReviews()), loadMatters(), loadRawStream(), loadChatConfig(), loadMailAccounts(), loadActivity(), loadConnections()]).catch((error) => {
      byId("hub-state").className = "badge danger";
      byId("top-summary").textContent = error.message;
    });
    window.setInterval(() => {
      pollHub().catch(() => { /* Retain the last good hub snapshot. */ });
    }, 5000);
  </script>
</body>
</html>
